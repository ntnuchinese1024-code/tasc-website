    font-size: 1.02rem;
    color: var(--ink);
  }

  .cd-mail {
    font-weight: 700;
    color: var(--blue-deep);
    user-select: all;
  }

  .cd-online-suggest {
    margin-top: 8px;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--green-deep);
    background: color-mix(in srgb, var(--green) 10%, var(--card));
    border: 1px solid color-mix(in srgb, var(--green) 30%, var(--line));
    border-radius: 10px;
    padding: 8px 14px;
    cursor: pointer;
  }

  .cd-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
    padding: 16px 20px;
    border-radius: 16px;
    background: var(--bg-alt);
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.6;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cd-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cd-cta strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
  }

  .cd-cta > span:last-child {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--blue-deep);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  /**
   * 地圖與搜尋的瀏覽器端邏輯。
   *
   * 狀態只有三個：關鍵字、地區、專長。每次變動就：
   *   1. 依三個條件決定哪些卡片要顯示
   *   2. 依「關鍵字＋專長」（不含地區）重算每個縣市的人數，更新地圖顏色與數字
   *   3. 把條件寫進網址（?q=&region=&specialty=），分享連結時對方看到的是同一個結果
   */
  const LABEL: Record<string, string> = {};

  function level(n: number) {
    return n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4;
  }

  function init(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>(".tw-map")!;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const tip = root.querySelector<HTMLElement>("[data-tip]")!;
    const qInput = root.querySelector<HTMLInputElement>("[data-q]")!;
    const regionSel = root.querySelector<HTMLSelectElement>("[data-region]")!;
    const specSel = root.querySelector<HTMLSelectElement>("[data-specialty]")!;
    const summary = root.querySelector<HTMLElement>("[data-summary]")!;
    const clearBtn = root.querySelector<HTMLButtonElement>("[data-clear]")!;
    const onlineBtn = root.querySelector<HTMLButtonElement>("[data-online]")!;
    const onlineCount = root.querySelector<HTMLElement>("[data-online-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const emptyHint = root.querySelector<HTMLElement>("[data-empty-hint]");
    const suggestOnline = root.querySelector<HTMLButtonElement>("[data-suggest-online]");
    const counties = Array.from(root.querySelectorAll<SVGPathElement>(".tw-county"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-card]"));
    const total = cards.length;

    for (const opt of Array.from(regionSel.options)) if (opt.value) LABEL[opt.value] = opt.textContent ?? opt.value;

    const state = { q: "", region: "", specialty: "" };

    // ---- 網址 ↔ 狀態 --------------------------------------------------------
    const params = new URLSearchParams(location.search);
    state.q = params.get("q") ?? "";
    state.region = LABEL[params.get("region") ?? ""] ? params.get("region")! : "";
    const spec = params.get("specialty") ?? "";
    state.specialty = Array.from(specSel.options).some((o) => o.value === spec) ? spec : "";

    function writeUrl() {
      const p = new URLSearchParams(location.search);
      for (const key of ["q", "region", "specialty"] as const) {
        if (state[key]) p.set(key, state[key]);
        else p.delete(key);
      }
      const qs = p.toString();
      history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
    }

    // ---- 篩選 ---------------------------------------------------------------
    function matchesText(card: HTMLElement) {
      const tokens = state.q.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const blob = card.dataset.search ?? "";
      return tokens.every((t) => blob.includes(t));
    }

    function matchesSpecialty(card: HTMLElement) {
      return !state.specialty || (card.dataset.specialties ?? "").split("|").includes(state.specialty);
    }

    function apply() {
      const counts: Record<string, number> = {};
      let shown = 0;

      for (const card of cards) {
        const base = matchesText(card) && matchesSpecialty(card);
        const regions = (card.dataset.regions ?? "").split(" ");
        if (base) for (const r of regions) counts[r] = (counts[r] ?? 0) + 1;
        const visible = base && (!state.region || regions.includes(state.region));
        card.hidden = !visible;
        if (visible) shown += 1;

        card.querySelectorAll<HTMLElement>(".cd-tags li").forEach((li) => {
          li.classList.toggle("is-match", !!state.specialty && li.textContent === state.specialty);
        });
        // 選了某個專長而它被收在「＋N 項」裡時，直接展開
        if (state.specialty) {
          const tags = card.querySelector(".cd-tags");
          if (tags?.querySelector(".is-extra.is-match")) tags.classList.add("is-open");
        }
      }

      // 地圖
      for (const path of counties) {
        const code = path.dataset.code!;
        const n = counts[code] ?? 0;
        const selected = state.region === code;
        const up = path.classList.contains("is-up");
        path.setAttribute(
          "class",
          `tw-county ${path.dataset.group} lv-${level(n)}${selected ? " is-selected" : ""}${up ? " is-up" : ""}`,
        );
        // 選到的縣市畫在最上層，抬起來時不會被鄰居蓋住
        if (selected) bringToFront(path);
        path.setAttribute("aria-pressed", String(state.region === code));
        path.setAttribute("aria-label", `${path.dataset.label}，${n} 位性諮商師`);
        const badge = root.querySelector<SVGGElement>(`[data-badge-for="${code}"]`);
        if (badge) {
          badge.toggleAttribute("hidden", n === 0);
          badge.querySelector("text")!.textContent = String(n);
        }
        root.querySelector(`[data-label-for="${code}"]`)?.classList.toggle("is-active", state.region === code);
      }
      svg.classList.toggle("has-selection", !!state.region && state.region !== "online");

      onlineCount.textContent = String(counts.online ?? 0);
      onlineBtn.setAttribute("aria-pressed", String(state.region === "online"));
      regionSel.value = state.region;
      specSel.value = state.specialty;
      if (qInput.value !== state.q) qInput.value = state.q;

      // 文字
      const filtered = !!(state.q.trim() || state.region || state.specialty);
      clearBtn.hidden = !filtered;
      if (total > 0) {
        const parts: string[] = [];
        if (state.region) parts.push(LABEL[state.region]);
        if (state.specialty) parts.push(`專長「${state.specialty}」`);
        if (state.q.trim()) parts.push(`關鍵字「${state.q.trim()}」`);
        summary.textContent = filtered
          ? `${parts.join("・")}：找到 ${shown} 位`
          : `共 ${total} 位性諮商師提供了執業資料`;
      }

      if (empty) {
        empty.hidden = shown > 0 || total === 0;
        const canGoOnline = !!state.region && state.region !== "online" && (counts.online ?? 0) > 0;
        if (suggestOnline) suggestOnline.hidden = !canGoOnline;
        if (emptyHint) {
          emptyHint.textContent = state.region && state.region !== "online"
            ? `${LABEL[state.region]}目前還沒有符合條件的性諮商師登錄資料。${canGoOnline ? "不受地點限制的話，可以考慮線上諮商：" : "可以放寬條件，或來信 tasc.tw@gmail.com 請秘書處協助轉介。"}`
            : "試試看換個關鍵字，或放寬地區、專長的條件。";
        }
      }

      writeUrl();
    }

    function bringToFront(path: SVGPathElement) {
      if (path.parentNode && path.parentNode.lastElementChild !== path) path.parentNode.appendChild(path);
    }

    /** 縣市、它的名稱、人數圓圈一起抬起或放下。 */
    function lift(code: string, up: boolean) {
      root.querySelector(`.tw-county[data-code="${code}"]`)?.classList.toggle("is-up", up);
      root.querySelector(`[data-label-for="${code}"]`)?.classList.toggle("is-up", up);
      root.querySelector(`[data-badge-for="${code}"]`)?.classList.toggle("is-up", up);
    }

    function setRegion(code: string) {
      state.region = state.region === code ? "" : code;
      apply();
    }

    // ---- 事件 ---------------------------------------------------------------
    let typing: number | undefined;
    qInput.addEventListener("input", () => {
      window.clearTimeout(typing);
      typing = window.setTimeout(() => {
        state.q = qInput.value;
        apply();
      }, 120);
    });
    regionSel.addEventListener("change", () => {
      state.region = regionSel.value;
      apply();
    });
    specSel.addEventListener("change", () => {
      state.specialty = specSel.value;
      apply();
    });
    onlineBtn.addEventListener("click", () => setRegion("online"));
    suggestOnline?.addEventListener("click", () => setRegion("online"));
    clearBtn.addEventListener("click", () => {
      state.q = "";
      state.region = "";
      state.specialty = "";
      apply();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((btn) =>
      btn.addEventListener("click", () => {
        btn.closest(".cd-tags")?.classList.add("is-open");
        btn.closest("li")?.remove();
      }),
    );

    // 地圖：點選、鍵盤、提示框
    function showTip(path: SVGPathElement, clientX?: number, clientY?: number) {
      const box = stage.getBoundingClientRect();
      let x: number;
      let y: number;
      if (clientX !== undefined && clientY !== undefined) {
        x = clientX - box.left;
        y = clientY - box.top;
      } else {
        const r = path.getBoundingClientRect();
        x = r.left + r.width / 2 - box.left;
        y = r.top - box.top + 6;
      }
      const n = path.getAttribute("aria-label")?.match(/(\d+) 位/)?.[1] ?? "0";
      tip.innerHTML = "";
      tip.append(path.dataset.label ?? "");
      const small = document.createElement("small");
      small.textContent = n === "0" ? "目前沒有登錄資料" : `${n} 位性諮商師・點一下查看`;
      tip.append(small);
      tip.style.left = `${x}px`;
      tip.style.top = `${y}px`;
      tip.hidden = false;
    }

    /** 手機上地圖跟清單是上下排的，點了縣市要帶到結果那裡，不然看不出有變化。 */
    function pickFromMap(code: string) {
      setRegion(code);
      tip.hidden = true;
      if (state.region && window.matchMedia("(max-width: 900px)").matches) {
        summary.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function hideTip() {
      tip.hidden = true;
    }

    /**
     * 指到就跳起來：先把它移到最上層（不然會被南邊的鄰居蓋住），
     * 下一個畫面再加上 is-up，彈跳的過場才會播出來。
     */
    function hoverOn(path: SVGPathElement) {
      bringToFront(path);
      requestAnimationFrame(() => lift(path.dataset.code!, true));
    }

    function hoverOff(path: SVGPathElement) {
      lift(path.dataset.code!, false);
    }

    for (const path of counties) {
      path.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse" || e.pointerType === "pen") hoverOn(path);
      });
      path.addEventListener("pointermove", (e) => {
        if (e.pointerType === "mouse" || e.pointerType === "pen") showTip(path, e.clientX, e.clientY);
      });
      path.addEventListener("pointerleave", () => {
        hoverOff(path);
        hideTip();
      });
      path.addEventListener("focus", () => {
        hoverOn(path);
        showTip(path);
      });
      path.addEventListener("blur", () => {
        hoverOff(path);
        hideTip();
      });
      path.addEventListener("click", () => pickFromMap(path.dataset.code!));
      path.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          pickFromMap(path.dataset.code!);
        }
      });
    }

    // 從合格名單點名字過來：#counselor-<id> 或 ?name=
    function flashFromHash() {
      const target = location.hash.startsWith("#counselor-") ? root.querySelector<HTMLElement>(location.hash) : null;
      if (!target) return;
      if (target.hidden) {
        state.q = "";
        state.region = "";
        state.specialty = "";
        apply();
      }
      target.classList.add("is-flash");
      target.scrollIntoView({ behavior: "smooth", block: "center" });
      window.setTimeout(() => target.classList.remove("is-flash"), 2400);
    }
    window.addEventListener("hashchange", flashFromHash);

    apply();
    flashFromHash();
  }

  document.querySelectorAll<HTMLElement>("[data-directory]").forEach(init);
</script>
