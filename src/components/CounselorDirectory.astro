  }

  .cd-empty,
  .cd-empty-all {
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 16px;
    padding: 26px 22px;
    font-size: 0.88rem;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .cd-empty p,
  .cd-empty-all p {
    margin: 0 0 6px;
  }

  .cd-empty-title {
    font-family: var(--font-display);
