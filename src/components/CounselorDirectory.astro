---
/**
 * 合格性諮商師名單的「地圖＋搜尋」工具。
 *
 * 資料：性諮商師在 /counselors/profile 填寫、秘書處在報名系統後台審核通過的執業資料，
 * 官網建置時抓下來寫進 HTML（見 lib/registration-api.ts 的 getCounselorProfiles）。
 * 所以所有卡片都是建置時就產生好的，篩選只是在瀏覽器端切換顯示，Google 也讀得到。
 *
 * 地圖：src/data/taiwan-map.json（由 scripts/build-taiwan-map.mjs 產生）。
 * 「立體」是兩件事疊出來的：SVG 裡把島的外框往下疊幾層當作厚度，
 * 再用 CSS 把整張圖往後傾斜。點縣市＝篩選該地區；縣市的顏色深淺跟數字，
 * 會隨著目前的搜尋條件即時變化（例如選了某個專長，就看得到哪裡有這方面的性諮商師）。
 */
import map from "../data/taiwan-map.json";
import {
  REGIONS,
  REGION_BY_CODE,
  REGION_GROUPS,
  SPECIALTY_ORDER,
} from "../data/counselor-directory";
import type { CounselorProfile } from "../lib/registration-api";

interface Props {
  profiles: CounselorProfile[];
}

const { profiles } = Astro.props;

const sorted = [...profiles].sort((a, b) => a.name.localeCompare(b.name, "zh-Hant"));

/** 每個縣市幾位（建置時的初始值；瀏覽器端會依搜尋條件重算）。 */
const countBy: Record<string, number> = {};
for (const p of sorted) for (const r of p.regions) countBy[r] = (countBy[r] ?? 0) + 1;

/** 地圖配色：每個區域一個學會標誌色（北藍、中綠、南橙、東洋紅、離島金黃）。 */
const GROUP_CLASS: Record<string, string> = {
  北部: "g-north",
  中部: "g-central",
  南部: "g-south",
  東部: "g-east",
  離島: "g-island",
};

const MAP_LEGEND = [
  { label: "北部", cls: "g-north" },
  { label: "中部", cls: "g-central" },
  { label: "南部", cls: "g-south" },
  { label: "東部", cls: "g-east" },
  { label: "離島", cls: "g-island" },
];

const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : n <= 6 ? 3 : 4);

/** 專長篩選選單：範本的順序在前，自填的排後面。 */
const allSpecialties = Array.from(new Set(sorted.flatMap((p) => p.specialties))).sort((a, b) => {
  const ia = SPECIALTY_ORDER.indexOf(a);
  const ib = SPECIALTY_ORDER.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b, "zh-Hant");
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});

/**
 * 地圖上不放常駐名稱的縣市（滑過或點選時仍會顯示）：太小、會跟鄰居擠在一起的，
 * 以及小框標題已經寫了名字的金門、馬祖。
 */
const NO_LABEL = new Set(["hsinchu-city", "chiayi-city", "kinmen", "lienchiang"]);

/** 人數小圓點的位置（相對縣市標籤）。北部縣市擠在一起，個別錯開。 */
const BADGE_OFFSET: Record<string, [number, number]> = {
  taipei: [-24, -6],
  "new-taipei": [24, 4],
  keelung: [20, -10],
  "hsinchu-city": [-16, -10],
  "chiayi-city": [-16, -8],
};

const DEPTH = 12;
const depthLayers = Array.from({ length: DEPTH }, (_, i) => DEPTH - i);

const mainCounties = map.counties.filter((c) => !map.insets.some((i) => i.code === c.code));
const insetCounties = map.counties.filter((c) => map.insets.some((i) => i.code === c.code));

const searchBlob = (p: CounselorProfile) =>
  [
    p.name,
    p.title,
    p.organization,
    p.location_note,
    p.intro,
    ...p.specialties,
    ...p.audiences,
    ...p.regions.map((r) => REGION_BY_CODE[r]?.label ?? r),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

const hostOf = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};

const SHOWN_SPECIALTIES = 6;
---

<div class="cd" data-directory>
  {/* ---- 地圖 ---------------------------------------------------------- */}
  <div class="cd-map-col">
    <div class="cd-stage" data-stage>
      <svg
        class="tw-map"
        viewBox={`0 0 ${map.width} ${map.height}`}
        role="group"
        aria-label="台灣縣市地圖：點選縣市可以篩選該地區的性諮商師"
      >
        <defs>
          <path id="tw-outline" d={map.outline} />
          {insetCounties.map((c) => <path id={`tw-depth-${c.code}`} d={c.d} />)}
        </defs>

        {/* 島的厚度：外框往下疊幾層，越下面越深 */}
        <g class="tw-depth" aria-hidden="true">
          {depthLayers.map((y) => (
            <use href="#tw-outline" y={y} class={y === DEPTH ? "tw-depth-bottom" : undefined} />
          ))}
        </g>

        {/* 金門、馬祖的小框 */}
        {map.insets.map((inset) => (
          <g class="tw-inset" aria-hidden="true">
            <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx="14" />
            <text x={inset.x + 14} y={inset.y + 24} class="tw-inset-title">{inset.title}</text>
          </g>
        ))}
        <g class="tw-depth" aria-hidden="true">
          {insetCounties.map((c) =>
            [4, 3, 2, 1].map((y) => <use href={`#tw-depth-${c.code}`} y={y} />),
          )}
        </g>

        {/* 縣市本體：可以點、可以用鍵盤選 */}
        <g class="tw-counties">
          {[...mainCounties, ...insetCounties].map((c) => {
            const region = REGION_BY_CODE[c.code];
            const n = countBy[c.code] ?? 0;
            return (
              <path
                d={c.d}
                class={`tw-county ${GROUP_CLASS[region?.group ?? ""] ?? "g-north"} lv-${level(n)}`}
                data-group={GROUP_CLASS[region?.group ?? ""] ?? "g-north"}
                data-code={c.code}
                data-label={region?.label ?? c.code}
                data-cx={c.cx}
                data-cy={c.cy}
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label={`${region?.label ?? c.code}，${n} 位性諮商師`}
              />
            );
          })}
        </g>

        <g class="tw-labels" aria-hidden="true">
          {map.counties.map((c) => (
            <text
              x={c.cx}
              y={c.cy}
              class={`tw-label${NO_LABEL.has(c.code) ? " tw-label-hover" : ""}`}
              data-label-for={c.code}
            >
              {REGION_BY_CODE[c.code]?.short ?? c.code}
            </text>
          ))}
        </g>

        <g class="tw-badges" aria-hidden="true">
          {map.counties.map((c) => {
            const n = countBy[c.code] ?? 0;
            const [dx, dy] = BADGE_OFFSET[c.code] ?? [16, -16];
            return (
              <g class="tw-badge" data-badge-for={c.code} transform={`translate(${c.cx + dx} ${c.cy + dy})`} hidden={n === 0}>
                <circle r="10.5" />
                <text dy="0.36em">{n}</text>
              </g>
            );
          })}
        </g>
      </svg>

      <div class="cd-tip" data-tip hidden></div>
    </div>

    <div class="cd-legend" aria-hidden="true">
      <span class="cd-legend-regions">
        {MAP_LEGEND.map((g) => (
          <span class={`cd-legend-item ${g.cls}`}><span class="sw"></span>{g.label}</span>
        ))}
      </span>
      <span class="cd-legend-note">顏色越深，人數越多；圓圈裡是人數</span>
    </div>

    <button type="button" class="cd-online" data-online aria-pressed="false">
      <span class="cd-online-dot" aria-hidden="true"></span>
      提供線上諮商
      <span class="cd-online-n" data-online-count>{countBy.online ?? 0}</span>
    </button>
  </div>

  {/* ---- 搜尋與結果 ---------------------------------------------------- */}
  <div class="cd-panel">
    <div class="cd-controls" role="search">
      <label class="cd-search">
        <span class="sr-only">搜尋性諮商師</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
        <input
          type="search"
          data-q
          placeholder="搜尋姓名、專長、機構，例如：伴侶、跨性別"
          autocomplete="off"
        />
      </label>

      <div class="cd-selects">
        <label>
          <span class="cd-select-label">地區</span>
          <select data-region>
            <option value="">全部地區</option>
            {REGION_GROUPS.map((group) => (
              <optgroup label={group}>
                {REGIONS.filter((r) => r.group === group).map((r) => (
                  <option value={r.code}>{r.label}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
        <label>
          <span class="cd-select-label">專長</span>
          <select data-specialty disabled={allSpecialties.length === 0}>
            <option value="">全部專長</option>
            {allSpecialties.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
      </div>
    </div>

    <div class="cd-status">
      <p data-summary aria-live="polite">
        {sorted.length > 0 ? `共 ${sorted.length} 位性諮商師提供了執業資料` : "執業資料建置中"}
      </p>
      <button type="button" class="cd-clear" data-clear hidden>清除條件</button>
    </div>

    {sorted.length === 0 ? (
      <div class="cd-empty-all">
        <p class="cd-empty-title">性諮商師的執業資料正在陸續建置中</p>
        <p>
          合格性諮商師填寫工作地區與專長、經秘書處確認後，就會出現在這張地圖上。
          在那之前，可以參考下方的合格名單，或來信
          <span class="cd-mail">tasc.tw@gmail.com</span> 請秘書處協助轉介。
        </p>
      </div>
    ) : (
      <>
        <ul class="cd-list" data-list>
          {sorted.map((p) => {
            const extra = p.specialties.length - SHOWN_SPECIALTIES;
            return (
              <li
                class="cd-card"
                id={`counselor-${p.id}`}
                data-card
                data-name={p.name}
                data-regions={p.regions.join(" ")}
                data-specialties={p.specialties.join("|")}
                data-search={searchBlob(p)}
              >
                <div class="cd-card-head">
                  <h3 class="cd-name">{p.name}</h3>
                  {p.title && <span class="cd-title">{p.title}</span>}
                </div>
                {p.organization && <p class="cd-org">{p.organization}</p>}

                <ul class="cd-regions" aria-label="工作地區">
                  {p.regions.map((r) => (
                    <li class={r === "online" ? "is-online" : undefined}>{REGION_BY_CODE[r]?.label ?? r}</li>
                  ))}
                </ul>

                {p.location_note && (
                  <p class="cd-place">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15s5-4.6 5-8.5a5 5 0 0 0-10 0C3 10.4 8 15 8 15Z" /><circle cx="8" cy="6.5" r="1.8" /></svg>
                    <span class="sr-only">執業地點：</span>{p.location_note}
                  </p>
                )}

                {p.specialties.length > 0 && (
                  <ul class="cd-tags" aria-label="專長">
                    {p.specialties.map((s, i) => (
                      <li class={i >= SHOWN_SPECIALTIES ? "is-extra" : undefined}>{s}</li>
                    ))}
                    {extra > 0 && (
                      <li class="cd-more">
                        <button type="button" data-more>＋{extra} 項</button>
                      </li>
                    )}
                  </ul>
                )}

                {p.audiences.length > 0 && (
                  <p class="cd-aud"><span>服務對象</span>{p.audiences.join("、")}</p>
                )}

                {p.intro && <p class="cd-intro">{p.intro}</p>}

                {(p.website_url || p.other_url) && (
                  <div class="cd-links">
                    {p.website_url && (
                      <a href={p.website_url} target="_blank" rel="noopener noreferrer nofollow" class="cd-link cd-link-main">
                        個人工作網頁 <span aria-hidden="true">↗</span>
                        <span class="cd-host">{hostOf(p.website_url)}</span>
                      </a>
                    )}
                    {p.other_url && (
                      <a href={p.other_url} target="_blank" rel="noopener noreferrer nofollow" class="cd-link">
                        其他連結 <span aria-hidden="true">↗</span>
                        <span class="cd-host">{hostOf(p.other_url)}</span>
                      </a>
                    )}
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        <div class="cd-empty" data-empty hidden>
          <p class="cd-empty-title">沒有符合條件的性諮商師</p>
          <p data-empty-hint>試試看換個關鍵字，或放寬地區、專長的條件。</p>
          <button type="button" class="cd-online-suggest" data-suggest-online hidden>改看提供線上諮商的性諮商師</button>
        </div>
      </>
    )}

    <a href="/counselors/profile" class="cd-cta">
      <span>
        <strong>我是合格性諮商師</strong>
        填寫或更新我的工作地區、專長與網頁連結
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .cd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 28px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .cd {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  .cd [hidden] {
    display: none !important;
  }

  /* ---- 地圖 ---- */
  .cd-map-col {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .cd-map-col {
      position: static;
    }
  }

  .cd-stage {
    position: relative;
    width: 100%;
    max-width: 500px;
    perspective: 1600px;
    border-radius: 28px;
    background:
      radial-gradient(ellipse 62% 48% at 58% 56%, rgba(0, 159, 232, 0.13), transparent 72%),
      radial-gradient(ellipse 40% 30% at 22% 22%, rgba(255, 240, 0, 0.08), transparent 70%);
  }

  @media (max-width: 900px) {
    .cd-stage {
      max-width: 400px;
    }
  }

  /* 整張圖固定往後傾斜，不隨滑鼠晃動；會動的只有被指到的那個縣市 */
  .tw-map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform: rotateX(24deg);
    transform-origin: 50% 60%;
  }

  /* ---- 每個區域一個標誌色。--c 原色、--deep 深色、--side 抬起來時看到的側面 ---- */
  .g-north {
    --c: #009fe8;
    --deep: #046492;
    --side: #0a5d86;
  }
  .g-central {
    --c: #1eab39;
    --deep: #0f7325;
    --side: #0e5f22;
  }
  .g-south {
    --c: #eb5613;
    --deep: #a33d0f;
    --side: #8a3510;
  }
  .g-east {
    --c: #e71374;
    --deep: #a20e53;
    --side: #860c46;
  }
  .g-island {
    --c: #f2b705;
    --deep: #9a6f00;
    --side: #7d5b00;
  }

  .tw-depth use {
    fill: #d8ccb3;
  }

  .tw-depth use.tw-depth-bottom {
    fill: #bfb08f;
    filter: drop-shadow(0 14px 14px rgba(33, 27, 20, 0.2));
  }

  .tw-inset rect {
    fill: rgba(255, 255, 255, 0.72);
    stroke: color-mix(in srgb, var(--c, #f2b705) 45%, var(--line));
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }

  .tw-inset-title {
    font-size: 15px;
    font-weight: 800;
    fill: #7d5b00;
    letter-spacing: 0.04em;
  }

  .tw-county {
    stroke: #fffdf7;
    stroke-width: 1.3;
    stroke-linejoin: round;
    cursor: pointer;
    outline: none;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    fill: color-mix(in srgb, var(--c) 16%, #fbf8f1);
    transition:
      transform 0.42s cubic-bezier(0.34, 1.7, 0.5, 1),
      fill 0.25s ease,
      filter 0.3s ease,
      opacity 0.25s ease;
  }

  /* 有人數的縣市：越多越飽和 */
  .tw-county.lv-1 {
    fill: color-mix(in srgb, var(--c) 42%, #fbf8f1);
  }
  .tw-county.lv-2 {
    fill: color-mix(in srgb, var(--c) 60%, #fbf8f1);
  }
  .tw-county.lv-3 {
    fill: color-mix(in srgb, var(--c) 78%, #fbf8f1);
  }
  .tw-county.lv-4 {
    fill: var(--c);
  }

  /* 指到（還沒點）：整塊彈跳起來，下面露出側面與影子 */
  .tw-county.is-up {
    transform: translateY(-11px) scale(1.02);
    fill: color-mix(in srgb, var(--c) 55%, #ffffff);
    filter:
      drop-shadow(0 2px 0 var(--side))
      drop-shadow(0 3px 0 var(--side))
      drop-shadow(0 4px 0 var(--side))
      drop-shadow(0 12px 10px rgba(33, 27, 20, 0.28));
  }

  .tw-county.lv-3.is-up,
  .tw-county.lv-4.is-up {
    fill: color-mix(in srgb, var(--c) 92%, #ffffff);
  }

  .tw-county:focus-visible {
    stroke: var(--ink);
    stroke-width: 2;
  }

  /* 點選後：維持抬起，換成深色 */
  .tw-county.is-selected {
    fill: var(--deep);
    transform: translateY(-11px) scale(1.02);
    filter:
      drop-shadow(0 2px 0 var(--side))
      drop-shadow(0 3px 0 var(--side))
      drop-shadow(0 4px 0 var(--side))
      drop-shadow(0 12px 10px rgba(33, 27, 20, 0.3));
  }

  .tw-map.has-selection .tw-county:not(.is-selected):not(.is-up) {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .tw-county,
    .tw-label,
    .tw-badge {
      transition: none !important;
    }
  }

  .tw-label {
    font-size: 14.5px;
    font-weight: 800;
    fill: #4a3f33;
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
    paint-order: stroke;
    stroke: rgba(255, 253, 247, 0.9);
    stroke-width: 3.5px;
    stroke-linejoin: round;
    transition:
      transform 0.42s cubic-bezier(0.34, 1.7, 0.5, 1),
      opacity 0.2s;
  }

  .tw-label-hover {
    opacity: 0;
  }

  /* 手機上整張圖縮小了，字要放大才看得清楚 */
  @media (max-width: 600px) {
    .tw-label {
      font-size: 17px;
    }
    .tw-inset-title {
      font-size: 19px;
    }
    .tw-badge text {
      font-size: 14px;
    }
  }

  .tw-label.is-active,
  .tw-label.is-up {
    opacity: 1;
  }

  .tw-label.is-up {
    transform: translateY(-11px);
    font-size: 15.5px;
  }

  .tw-label.is-active {
    fill: #fff;
    stroke: rgba(33, 27, 20, 0.35);
    transform: translateY(-11px);
  }

  .tw-badge {
    pointer-events: none;
  }

  .tw-badge > * {
    transition: transform 0.42s cubic-bezier(0.34, 1.7, 0.5, 1);
  }

  .tw-badge.is-up > * {
    transform: translateY(-11px);
  }

  .tw-badge circle {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 1.6;
    filter: drop-shadow(0 2px 2px rgba(33, 27, 20, 0.2));
  }

  .tw-badge text {
    font-size: 12px;
    font-weight: 800;
    fill: var(--ink);
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }

  .cd-tip {
    position: absolute;
    z-index: 3;
    transform: translate(-50%, calc(-100% - 16px));
    background: var(--ink);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
    padding: 7px 12px;
    border-radius: 10px;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: var(--shadow);
  }

  .cd-tip small {
    display: block;
    font-weight: 400;
    opacity: 0.8;
  }

  .cd-legend {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .cd-legend-regions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .cd-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sw {
    width: 22px;
    height: 10px;
    border-radius: 999px;
    display: inline-block;
