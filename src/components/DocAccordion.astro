---
/**
 * 長篇法規文件的版面（倫理守則、認證辦法、換證辦法都用這個）。
 *
 * 左邊是固定跟著捲動的章節目錄，右邊是條文本體。
 * 條文開頭如果有「一、」「（二）」這種編號，會被抓出來放到左邊當懸掛編號；
 * 編號後面若接一個短標題加全形冒號（例如「一、公共政策：」），
 * 那個短標題會自動變粗，方便一眼掃過去找到要看的那一條。
 */
/** 一條條文，底下可以再帶原文沒有編號的小點 */
export interface Clause {
  text: string;
  subItems?: string[];
}

/** 一個小標底下的內容（倫理守則那種三層結構用的） */
export interface Group {
  heading?: string;
  lead?: string;
  paragraphs?: string[];
  items?: Clause[];
  footnote?: string;
}

interface Section {
  title: string;
  color: string;
  colorText: string;
  /** 認證辦法、換證辦法這種「一章就是一串條文」的寫法 */
  paragraphs?: string[];
  /** 章開頭的引言 */
  lead?: string;
  /** 章層級就有的編號條文 */
  items?: Clause[];
  /** 章底下還要再分小標時用這個（倫理守則） */
  groups?: Group[];
}

interface Props {
  sections: Section[];
  /** 目錄上方的小標，預設「章節」 */
  tocTitle?: string;
}

const { sections, tocTitle = "章節" } = Astro.props;

// 條文編號有好幾種寫法：「一、」「壹.」「壹、」「（三）」「3.」都要抓得到
const NUM = /^((?:[一二三四五六七八九十壹貳參肆伍陸柒捌玖拾]+[、.．])|(?:（[一二三四五六七八九十壹貳參肆伍陸柒捌玖拾\d]+）)|(?:\d+[.、]))\s*/;

function parseParagraph(raw: string) {
  const m = raw.match(NUM);
  let num: string | null = null;
  let rest = raw;
  if (m) {
    num = m[1].replace(/[、。．.（）()]/g, "");  // 只留數字/中文數字本身
    rest = raw.slice(m[0].length);
  }

  // 「公共政策：」這種短前綴當小標；有逗號就不是小標，是正常句子
  let label: string | null = null;
  const colon = rest.indexOf("：");
  if (colon >= 2 && colon <= 10 && !/[，,。]/.test(rest.slice(0, colon))) {
    label = rest.slice(0, colon + 1);
    rest = rest.slice(colon + 1);
  }

  return { num, label, text: rest };
}

const CN = ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十",
            "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十"];
const cn = (i: number) => CN[i] ?? String(i + 1);

const parsed = sections.map((s) => {
  const paras = (s.paragraphs ?? []).map(parseParagraph);
  // 摘要列上顯示的數量：有條文就算條文，否則算段落
  const clauseCount =
    (s.items?.length ?? 0) +
    (s.groups ?? []).reduce((n, g) => n + (g.items?.length ?? 0) + (g.paragraphs?.length ?? 0), 0) +
    paras.length;
  return { ...s, paras, clauseCount };
});
---

<div class="doc-layout" data-doc>
  <nav class="doc-toc" aria-label={tocTitle}>
    <span class="toc-title">{tocTitle}</span>
    <ol>
      {parsed.map((s, i) => (
        <li>
          <a href={`#doc-${i}`} style={`--chapter: ${s.color}; --chapter-text: ${s.colorText}`}>
            <span class="toc-dot"></span>
            <span>{s.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <button type="button" class="toc-toggle" data-doc-toggle>全部展開</button>
  </nav>

  <div class="doc-accordion">
    {parsed.map((section, i) => (
      <details
        class="doc-item"
        id={`doc-${i}`}
        style={`--chapter: ${section.color}; --chapter-text: ${section.colorText}`}
        open={i === 0}
      >
        <summary>
          <span class="chapter-dot"></span>
          <span class="chapter-title">{section.title}</span>
          <span class="chapter-count">{section.clauseCount} 條</span>
        </summary>
        <div class="doc-body">
          {section.lead && <p class="doc-lead">{section.lead}</p>}

          {section.items && (
            <ol class="clause-list">
              {section.items.map((c, n) => (
                <li class="clause">
                  <span class="para-num">{cn(n)}</span>
                  <div class="clause-text">
                    <p>{c.text}</p>
                    {c.subItems && (
                      <ul class="sub-list">
                        {c.subItems.map((sub) => <li>{sub}</li>)}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          )}

          {section.paras.map((item) => (
            <p class:list={["doc-para", { "has-num": item.num }]}>
              {item.num && <span class="para-num">{item.num}</span>}
              <span class="para-text">
                {item.label && <strong>{item.label}</strong>}{item.text}
              </span>
            </p>
          ))}

          {section.groups?.map((g) => (
            <section class="doc-group">
              {g.heading && <h3 class="doc-subhead">{g.heading}</h3>}
              {g.lead && <p class="doc-lead">{g.lead}</p>}
              {g.paragraphs?.map((t) => <p class="doc-para"><span class="para-text">{t}</span></p>)}
              {g.items && (
                <ol class="clause-list">
                  {g.items.map((c, n) => (
                    <li class="clause">
                      <span class="para-num">{cn(n)}</span>
                      <div class="clause-text">
                        <p>{c.text}</p>
                        {c.subItems && (
                          <ul class="sub-list">
                            {c.subItems.map((sub) => <li>{sub}</li>)}
                          </ul>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              )}
              {g.footnote && <p class="doc-footnote">{g.footnote}</p>}
            </section>
          ))}
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .doc-layout {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .doc-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* ---- 左欄：章節目錄 ---- */
  .doc-toc {
    position: sticky;
    top: 88px;
  }

  @media (max-width: 900px) {
    .doc-toc {
      position: static;
      background: var(--bg-alt);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
    }
  }

  .toc-title {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 12px;
  }

  .doc-toc ol {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .doc-toc a {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .doc-toc a:hover {
    background: color-mix(in srgb, var(--chapter) 12%, transparent);
    color: var(--chapter-text);
  }

  .toc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--chapter);
    flex: none;
    transform: translateY(-1px);
  }

  .toc-toggle {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-soft);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 14px;
    cursor: pointer;
  }

  .toc-toggle:hover {
    border-color: var(--ink-faint);
    color: var(--ink);
  }

  /* ---- 右欄：條文 ---- */
  .doc-accordion {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .doc-item {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-left: 3px solid var(--chapter);
    border-radius: 12px;
    padding: 2px 22px;
    scroll-margin-top: 88px;
  }

  .doc-item summary {
    padding: 16px 0;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .doc-item summary::-webkit-details-marker {
    display: none;
  }

  .chapter-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--chapter);
    flex-shrink: 0;
  }

  .chapter-title {
    min-width: 0;
  }

  .chapter-count {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .doc-item summary::after {
    content: "▸";
    color: var(--chapter-text);
    transition: transform 0.15s ease;
    flex: none;
  }

  .doc-item[open] summary::after {
    transform: rotate(90deg);
  }

  .doc-body {
    padding: 4px 0 22px;
    border-top: 1px dashed var(--line);
  }

  .doc-para {
    display: flex;
    gap: 12px;
    font-size: 0.98rem;
    color: var(--ink);
    max-width: 44em;
    margin: 18px 0 0;
    line-height: 1.9;
  }

  /* 有編號的條文，編號掛在左邊，內文對齊成一直線 */
  .para-num {
    flex: none;
    /* 用 min-width 而不是固定寬度，「十一」這種兩個字的編號才不會被擠成兩行 */
    min-width: 1.9em;
    padding: 0 0.35em;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--chapter-text);
    background: color-mix(in srgb, var(--chapter) 13%, transparent);
    border-radius: 6px;
    height: fit-content;
  }

  .para-text {
    white-space: pre-line;
    min-width: 0;
  }

  .para-text strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* 沒有編號的段落不用留左邊的位置 */
  .doc-para:not(.has-num) {
    padding-left: 0;
  }

  /* ---- 小標（倫理守則的「一、公共政策」「原則三　服務對象的福祉」） ---- */
  .doc-group + .doc-group {
    margin-top: 30px;
  }

  .doc-subhead {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--chapter-text);
    margin: 26px 0 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--chapter) 26%, var(--line));
  }

  /* 小標前面的短色條，讓它跟條文明顯分層 */
  .doc-subhead::before {
    content: "";
    width: 4px;
    height: 1em;
    border-radius: 2px;
    background: var(--chapter);
    flex: none;
  }

  .doc-lead {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.9;
    max-width: 44em;
    margin: 14px 0 4px;
  }

  .doc-footnote {
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.85;
    max-width: 44em;
    margin: 14px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--line);
  }

  /* ---- 編號條文 ---- */
  .clause-list {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .clause {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    max-width: 44em;
  }

  .clause-text {
    min-width: 0;
  }

  .clause-text > p {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.9;
    margin: 0;
  }

  /* 條文底下更細的小點，原文沒有編號，用圓點列出 */
  .sub-list {
    margin: 8px 0 0;
    padding-left: 1.1em;
    list-style: none;
  }

  .sub-list li {
    position: relative;
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.85;
    margin-bottom: 4px;
  }

  .sub-list li::before {
    content: "";
    position: absolute;
    left: -1.1em;
    top: 0.82em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--chapter) 55%, var(--line));
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-doc]").forEach((root) => {
    const items = Array.from(root.querySelectorAll("details"));
    const btn = root.querySelector<HTMLButtonElement>("[data-doc-toggle]");
    if (!btn) return;

    const sync = () => {
      btn.textContent = items.every((d) => d.open) ? "全部收合" : "全部展開";
    };

    btn.addEventListener("click", () => {
      const shouldOpen = !items.every((d) => d.open);
      items.forEach((d) => (d.open = shouldOpen));
      sync();
    });

    items.forEach((d) => d.addEventListener("toggle", sync));

    // 從目錄點過去時，把該章節先打開再捲過去
    root.querySelectorAll<HTMLAnchorElement>(".doc-toc a").forEach((a) => {
      a.addEventListener("click", () => {
        const target = root.querySelector<HTMLDetailsElement>(a.getAttribute("href") || "");
        if (target) target.open = true;
      });
    });

    sync();
  });
</script>
