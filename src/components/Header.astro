---
import Logo from "./Logo.astro";

const navLinks = [
  { href: "/about", label: "關於我們" },
  { href: "/counselors", label: "性諮商師" },
  { href: "/news", label: "最新消息" },
  { href: "/annual", label: "年會專區" },
  { href: "/resources", label: "相關資源" },
  { href: "/contact", label: "聯絡我們" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <Logo size={36} />
      <span class="brand-word">台灣性諮商學會</span>
    </a>

    <nav class="nav-desktop" aria-label="主選單">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/membership" class="btn btn-primary btn-nav">會員申請</a>
    </nav>

    <details class="nav-mobile">
      <summary aria-label="開啟選單">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </summary>
      <div class="nav-mobile-panel">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="/membership" class="btn btn-primary">會員申請</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02rem;
    color: var(--ink);
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }

  .nav-desktop a:not(.btn) {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 8px 12px;
    border-radius: 999px;
  }

  .nav-desktop a:not(.btn):hover {
    color: var(--blue-deep);
    background: color-mix(in srgb, var(--blue) 8%, transparent);
  }

  .btn-nav {
    margin-left: 8px;
  }

  .nav-mobile {
    position: relative;
  }

  .nav-mobile summary {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 8px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .menu-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  .nav-mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 200px;
  }

  .nav-mobile-panel a:not(.btn) {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.92rem;
  }

  .nav-mobile-panel a:not(.btn):hover {
    background: var(--bg-alt);
    color: var(--ink);
  }

  .nav-mobile-panel .btn {
    text-align: center;
    margin-top: 6px;
  }

  @media (min-width: 860px) {
    .nav-desktop {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
  }
</style>
