---
import Logo from "./Logo.astro";

const navLinks = [
  { href: "/about", label: "關於我們" },
  { href: "/counselors", label: "性諮商師" },
  { href: "/news", label: "最新消息" },
  { href: "/newsletter", label: "電子報" },
  { href: "/annual", label: "年會專區" },
  { href: "/resources", label: "相關資源" },
  { href: "/invite", label: "講師邀約" },
  { href: "/contact", label: "聯絡我們" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <Logo size={36} />
      <span class="brand-word">台灣性諮商學會</span>
    </a>

    <nav class="nav-desktop" aria-label="主選單">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/membership" class="btn btn-primary btn-nav">會員申請</a>
    </nav>

    <details class="nav-mobile">
      <summary aria-label="開啟選單">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </summary>
      <div class="nav-mobile-panel">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="/membership" class="btn btn-primary">會員申請</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /*
   * 頁首比內文寬：站上其他地方的 .wrap 是 1080px，但選單八項加標誌加按鈕
   * 大約要 1000px 以上才排得下，擠在 1080 裡只剩不到 20px 餘裕——使用者
   * 只要把瀏覽器字級調大一點，標誌就會壓到第一個選單項目上。
   */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1280px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    /* 不要被選單擠扁 */
    flex: 0 0 auto;
  }

  .brand-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02rem;
    color: var(--ink);
    /* 學會全名不能斷成兩行 */
    white-space: nowrap;
  }

  /*
   * 選單項目本身永遠不斷字（white-space: nowrap），但整個選單允許換行：
   * 萬一使用者的字級特別大、或之後又多加了項目，最壞情況是選單掉到第二行，
   * 而不是疊在標誌上面。2026-11 兩種情形都實際發生過。
   */
  .nav-desktop {
    display: none;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    row-gap: 4px;
    gap: 6px;
    font-size: 0.9rem;
    min-width: 0;
  }

  .nav-desktop a:not(.btn) {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 8px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .nav-desktop .btn-nav {
    white-space: nowrap;
  }

  .nav-desktop a:not(.btn):hover {
    color: var(--blue-deep);
    background: color-mix(in srgb, var(--blue) 8%, transparent);
  }

  .btn-nav {
    margin-left: 8px;
  }

  .nav-mobile {
    position: relative;
  }

  .nav-mobile summary {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 8px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .menu-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  .nav-mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 200px;
  }

  .nav-mobile-panel a:not(.btn) {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.92rem;
  }

  .nav-mobile-panel a:not(.btn):hover {
    background: var(--bg-alt);
    color: var(--ink);
  }

  .nav-mobile-panel .btn {
    text-align: center;
    margin-top: 6px;
  }

  /*
   * 主選單有八項加一顆「會員申請」，加上標誌大約要 1000px 才排得下。
   * 2026-11 以前斷點設在 940px，結果 940～1100px 之間每一項都被擠成兩行
   * （「關於我 / 們」），標誌的全名也跟著斷。寧可多用一段漢堡選單。
   * 之後若增減選單項目，這個數字要跟著調。
   */
  @media (min-width: 1180px) {
    .nav-desktop {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
  }
</style>
