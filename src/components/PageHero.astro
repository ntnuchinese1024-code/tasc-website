---
import { wrapHeadingHtml } from "../lib/wrap-heading";
import FigureRing from "./decor/FigureRing.astro";

interface Props {
  eyebrow: string;
  eyebrowHref?: string;
  /** Renders "<a>label</a> · {eyebrow}" instead of a single link/span */
  breadcrumb?: { label: string; href: string };
  title: string;
  lead?: string;
  /** true if `title` already contains HTML (e.g. pre-wrapped) */
  titleIsHtml?: boolean;
  /** 標題右邊那塊空白要不要放標誌延伸出來的三人環線稿；長標題的頁面可以關掉 */
  decor?: boolean;
}

const { eyebrow, eyebrowHref, breadcrumb, title, lead, titleIsHtml = false, decor = true } = Astro.props;
---

<header class="page-hero">
  {decor && <FigureRing class="decor-layer hero-ring" variant="outline" />}
  <div class="wrap decor-above">
    {breadcrumb ? (
      <span class="eyebrow hero-eyebrow">
        <a href={breadcrumb.href}>{breadcrumb.label}</a> · {eyebrow}
      </span>
    ) : eyebrowHref ? (
      <a href={eyebrowHref} class="eyebrow hero-eyebrow">{eyebrow}</a>
    ) : (
      <span class="eyebrow hero-eyebrow">{eyebrow}</span>
    )}
    {titleIsHtml ? (
      <h1 set:html={title} />
    ) : (
      <h1 set:html={wrapHeadingHtml(title)} />
    )}
    {lead && <p class="hero-lead">{lead}</p>}
    <div class="hero-extra">
      <slot />
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--bg-alt);
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--line);
  }

  /* 標題最寬 46rem，內容區最寬 1080px，所以寬螢幕上右邊固定有一塊空白，
     三人環就放在那裡。故意讓它超出右緣一點，看起來像延伸出去而不是被塞進角落。 */
  .page-hero :global(.hero-ring) {
    width: 190px;
    height: 190px;
    top: 50%;
    transform: translateY(-50%);
    /* 右緣對齊內容欄（最寬 1080px、左右各留 32px）的右邊界，
       這樣它看起來是版面的一部分，不是隨便貼在角落 */
    right: max(24px, calc(50% - 540px + 32px));
    opacity: 0.4;
  }

  @media (max-width: 1100px) {
    /* 空間不夠時縮小、往外推，避免壓到標題 */
    .page-hero :global(.hero-ring) {
      width: 150px;
      height: 150px;
      right: -34px;
      opacity: 0.3;
    }
  }

  @media (max-width: 640px) {
    .page-hero :global(.hero-ring) {
      width: 150px;
      height: 150px;
      top: -28px;
      right: -46px;
      transform: none;
      opacity: 0.32;
    }
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--blue-deep);
    text-decoration: none;
  }

  a.hero-eyebrow:hover {
    text-decoration: underline;
  }

  .hero-eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .hero-eyebrow a:hover {
    text-decoration: underline;
  }

  .page-hero h1 {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    line-height: 1.42;
    font-weight: 800;
    max-width: 46rem;
  }

  .hero-lead {
    margin: 18px 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 58ch;
  }

  .hero-extra:empty {
    display: none;
  }

  .hero-extra {
    margin-top: 20px;
  }
</style>
