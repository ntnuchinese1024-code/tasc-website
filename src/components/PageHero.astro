---
import { wrapHeadingHtml } from "../lib/wrap-heading";

interface Props {
  eyebrow: string;
  eyebrowHref?: string;
  /** Renders "<a>label</a> · {eyebrow}" instead of a single link/span */
  breadcrumb?: { label: string; href: string };
  title: string;
  lead?: string;
  /** true if `title` already contains HTML (e.g. pre-wrapped) */
  titleIsHtml?: boolean;
}

const { eyebrow, eyebrowHref, breadcrumb, title, lead, titleIsHtml = false } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    {breadcrumb ? (
      <span class="eyebrow hero-eyebrow">
        <a href={breadcrumb.href}>{breadcrumb.label}</a> · {eyebrow}
      </span>
    ) : eyebrowHref ? (
      <a href={eyebrowHref} class="eyebrow hero-eyebrow">{eyebrow}</a>
    ) : (
      <span class="eyebrow hero-eyebrow">{eyebrow}</span>
    )}
    {titleIsHtml ? (
      <h1 set:html={title} />
    ) : (
      <h1 set:html={wrapHeadingHtml(title)} />
    )}
    {lead && <p class="hero-lead">{lead}</p>}
    <div class="hero-extra">
      <slot />
    </div>
  </div>
</header>

<style>
  .page-hero {
    background: var(--bg-alt);
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--line);
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--blue-deep);
    text-decoration: none;
  }

  a.hero-eyebrow:hover {
    text-decoration: underline;
  }

  .hero-eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .hero-eyebrow a:hover {
    text-decoration: underline;
  }

  .page-hero h1 {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    line-height: 1.42;
    font-weight: 800;
    max-width: 46rem;
  }

  .hero-lead {
    margin: 18px 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 58ch;
  }

  .hero-extra:empty {
    display: none;
  }

  .hero-extra {
    margin-top: 20px;
  }
</style>
