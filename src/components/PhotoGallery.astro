---
/**
 * 活動現場照片牆。
 *
 * 照片放在 public/images/annual/<年份>/ 底下，檔名用「年份-編號」。
 * 每張都會裁成一樣的 4:3 方塊，點下去可以開原圖。
 * 照片長寬不一（有直式手機拍的、也有 Zoom 截圖），統一裁切版面才不會參差不齊。
 */
interface Props {
  photos: string[];
  /** 給每張照片的替代文字用，例如「2023年會」 */
  label: string;
  title?: string;
  note?: string;
}

const { photos, label, title = "當天現場", note } = Astro.props;
---

{photos.length > 0 && (
  <section class="gallery">
    <h2>{title}</h2>
    {note && <p class="gallery-note">{note}</p>}
    <div class="gallery-grid">
      {photos.map((src, i) => (
        <a href={src} target="_blank" rel="noopener" class="gallery-item" title="點圖看原尺寸照片">
          <img src={src} alt={`${label}現場照片 ${i + 1}`} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .gallery {
    margin: 40px 0 8px;
    padding-top: 28px;
    border-top: 1px dashed var(--line);
  }

  .gallery h2 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .gallery-note {
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0 0 16px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gallery-item {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--card);
    line-height: 0;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.04);
  }
</style>
