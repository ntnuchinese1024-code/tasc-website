---
import { WEB3FORMS_ACCESS_KEY, WEB3FORMS_READY } from "../lib/web3forms";

interface Props {
  courseName: string;
  courseDate: string;
  id?: string;
}

const { courseName, courseDate, id = "register" } = Astro.props;
const formId = `regform-${id}`;
---

<div class="reg-card" id={id}>
  <h2>線上報名</h2>
  <p class="reg-course">{courseName}　{courseDate}</p>

  {!WEB3FORMS_READY && (
    <p class="reg-pending">
      這場報名表單還在設定中，請先寄信到 <a href="mailto:tasc.tw@gmail.com">tasc.tw@gmail.com</a> 報名，我們會盡快回覆。
    </p>
  )}

  <form id={formId} class:list={["reg-form", { "is-disabled": !WEB3FORMS_READY }]} novalidate>
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value={`課程報名｜${courseName}（${courseDate}）`} />
    <input type="checkbox" name="botcheck" class="hidden-field" tabindex="-1" autocomplete="off" />

    <div class="reg-row">
      <label for={`${formId}-name`}>姓名</label>
      <input type="text" id={`${formId}-name`} name="name" required disabled={!WEB3FORMS_READY} />
    </div>

    <div class="reg-row">
      <label for={`${formId}-email`}>Email</label>
      <input type="email" id={`${formId}-email`} name="email" required disabled={!WEB3FORMS_READY} />
    </div>

    <div class="reg-row">
      <label for={`${formId}-phone`}>聯絡電話</label>
      <input type="tel" id={`${formId}-phone`} name="phone" required disabled={!WEB3FORMS_READY} />
    </div>

    <div class="reg-row">
      <label for={`${formId}-status`}>身份</label>
      <select id={`${formId}-status`} name="status" disabled={!WEB3FORMS_READY}>
        <option value="會員">本會會員</option>
        <option value="非會員">非會員</option>
        <option value="學生">學生</option>
      </select>
    </div>

    <div class="reg-row">
      <label for={`${formId}-note`}>備註（選填）</label>
      <textarea id={`${formId}-note`} name="note" rows="3" disabled={!WEB3FORMS_READY}></textarea>
    </div>

    <button type="submit" class="btn btn-primary reg-submit" disabled={!WEB3FORMS_READY}>
      送出報名
    </button>

    <p class="reg-status" role="status" aria-live="polite"></p>
  </form>
</div>

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  const statusEl = form?.querySelector(".reg-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector(".reg-submit");
    if (!submitButton || !statusEl) return;

    submitButton.disabled = true;
    submitButton.textContent = "送出中…";
    statusEl.textContent = "";
    statusEl.classList.remove("is-error", "is-success");

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (result.success) {
        statusEl.textContent = "報名已送出，我們會盡快跟您確認，謝謝！";
        statusEl.classList.add("is-success");
        form.reset();
      } else {
        statusEl.textContent = "送出時遇到一點狀況，要不要直接寫信到 tasc.tw@gmail.com？";
        statusEl.classList.add("is-error");
      }
    } catch (error) {
      statusEl.textContent = "網路好像不太順，要不要直接寫信到 tasc.tw@gmail.com？";
      statusEl.classList.add("is-error");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "送出報名";
    }
  });
</script>

<style>
  .reg-card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
  }

  .reg-card h2 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .reg-course {
    font-size: 0.86rem;
    color: var(--ink-faint);
    margin: 0 0 20px;
  }

  .reg-pending {
    font-size: 0.86rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--gold) 18%, var(--card));
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 0 0 20px;
  }

  .reg-pending a {
    color: var(--blue-deep);
    font-weight: 700;
  }

  .reg-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .reg-form.is-disabled {
    opacity: 0.55;
  }

  .reg-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .reg-row label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
  }

  .reg-row input,
  .reg-row select,
  .reg-row textarea {
    font: inherit;
    font-size: 0.9rem;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
  }

  .reg-row input:focus,
  .reg-row select:focus,
  .reg-row textarea:focus {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
  }

  .hidden-field {
    display: none;
  }

  .reg-submit {
    margin-top: 4px;
  }

  .reg-submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .reg-status {
    font-size: 0.84rem;
    margin: 0;
    min-height: 1.2em;
  }

  .reg-status.is-success {
    color: var(--green-deep);
  }

  .reg-status.is-error {
    color: var(--red-deep);
  }
</style>
