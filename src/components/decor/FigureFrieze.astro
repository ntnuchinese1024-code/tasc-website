---
/*
  人形橫帶：把標誌上那個「頭 ＋ 環抱的手臂」拆下來，沿著一條水平線重複，
  變成一排手牽手的人。用在區塊之間的分隔、頁尾上緣這種長條空白。

  用 SVG <pattern> 平鋪而不是把圖拉寬，所以不管容器多寬，人形比例都不會被拉扁。
  一個 tile 放四個人（紅藍黃綠），這樣顏色才會循環。
*/
interface Props {
  class?: string;
  /** 圖形大小倍率；1 ≈ 高 30px */
  scale?: number;
}
const { class: className = "", scale = 1 } = Astro.props;

const FIGURE_W = 36;
const TILE_H = 30;
const colors = ["var(--red)", "var(--blue)", "var(--gold)", "var(--green)"];
const id = `frieze-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class={className}
  width="100%"
  height={TILE_H * scale}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id={id}
      patternUnits="userSpaceOnUse"
      width={FIGURE_W * colors.length}
      height={TILE_H}
      patternTransform={`scale(${scale})`}
    >
      {colors.map((color, i) => (
        <g transform={`translate(${i * FIGURE_W} 0)`} fill="none">
          {/* 手臂：兩端落在同一條基線上，跟左右鄰居接起來就像牽著手 */}
          <path
            d={`M 0 26 Q ${FIGURE_W / 2} 0 ${FIGURE_W} 26`}
            stroke={color}
            stroke-width="5"
            stroke-linecap="round"
          />
          <circle cx={FIGURE_W / 2} cy="8" r="6" fill={color} />
        </g>
      ))}
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
