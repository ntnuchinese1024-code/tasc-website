---
/*
  單一人形：標誌上的一個人（頭＋張開環抱的手臂），把弧線攤平成一個。
  小尺寸可以當清單項目的記號，大尺寸可以當空狀態／說明卡片的插圖。
*/
interface Props {
  class?: string;
  color?: string;
  /** true 時手臂只畫線、頭也是空心，更輕 */
  outline?: boolean;
}
const { class: className = "", color = "var(--blue)", outline = false } = Astro.props;
---

<svg class={className} viewBox="0 0 40 32" fill="none" aria-hidden="true" focusable="false">
  <path
    d="M 2 27 Q 20 1 38 27"
    stroke={color}
    stroke-width="5"
    stroke-linecap="round"
  />
  {outline ? (
    <circle cx="20" cy="9" r="6" stroke={color} stroke-width="5" />
  ) : (
    <circle cx="20" cy="9" r="6.5" fill={color} />
  )}
</svg>
