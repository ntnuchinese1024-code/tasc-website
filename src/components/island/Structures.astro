<style is:global>
  /* 這些類別要套用到 <use> 複製出來的節點上，所以不能是 scoped 樣式 */
  .s-lit { fill: #FBF7EE; }
  .s-mid { fill: #E2D8C6; }
  .s-shade { fill: #2E2A24; opacity: 0.16; }
  .s-stone { fill: #D9D2C3; }
  .s-stone-d { fill: #B5AB98; }
  .s-deep { fill: var(--lm-deep, #574F45); }
  .s-accent { fill: var(--lm-color, #C8553D); }
  .s-wood { fill: #B08855; }
  .s-wood-d { fill: #866440; }
  .s-glass { fill: #A7CEE0; }
  .s-beam { fill: #FFF0B8; opacity: calc(0.3 + var(--lamp, 0) * 0.65); transition: opacity 0.45s ease; }
  /* 窗戶：--lamp 是地圖的時間（0 白天、1 夜晚） */
  .h-roof { fill: var(--roof, #C8553D); }
  .win { fill: #9FC3D8; }
  .win-lit { fill: #FFE2A3; opacity: var(--lamp, 0); transition: opacity 0.45s ease; }
  .win-glow { fill: #FFD98A; opacity: calc(var(--lamp, 0) * 0.8); transition: opacity 0.45s ease; }
  .s-line { fill: none; stroke: #6E6558; stroke-width: 1.5; stroke-linecap: round; }
  .s-post { fill: none; stroke: #866440; stroke-width: 3; stroke-linecap: round; }
  .s-rod { fill: none; stroke: var(--lm-deep, #574F45); stroke-width: 2.4; stroke-linecap: round; }
  .s-globe-line { fill: none; stroke: #FBF7EE; stroke-width: 1.4; opacity: 0.85; }
  .band { fill: none; stroke-width: 4; }
  .lamps ellipse { fill: #D9452F; stroke: #8E2C1E; stroke-width: 1.2; }
  /* 街區的量體：左牆受光、右牆背光，頂面最亮 */
  .b-shadow { fill: #2E2A24; opacity: 0.17; }
  .b-wall-l { fill: #FBF7EE; }
  .b-wall-r { fill: #CDC0A9; }
  .b-roof { fill: #EFE7D7; }
  .b-roof-d { fill: color-mix(in srgb, var(--roof, #C8553D) 78%, #2E2A24); }
  .b-awning { fill: var(--lm-color, #C8553D); opacity: 0.85; }
  .b-tank { fill: #B5AB98; }
  .b-door { fill: #6E6558; }
  /* 夜裡整排窗戶一起亮。<use> 複製出來的節點吃不到祖先選擇器，只吃得到
     繼承下來的 CSS 變數，所以亮度是用 --lamp 混色算的（不支援 color-mix
     的瀏覽器就停在白天的藍色）。 */
  .win-set path { fill: #9FC3D8; }
  .win-set path { fill: color-mix(in srgb, #FFE2A3 calc(var(--lamp, 0) * 100%), #9FC3D8); }

  /* 海上的小船 */
  .boat-wake { fill: #FFFFFF; opacity: 0.5; }
  .boat-hull { fill: #F6F1E6; }
  .boat-hull-d { fill: #D4C8B2; }
  .boat-sail { fill: var(--lm-color, #3B7CA8); opacity: 0.92; }
  .boat-jib { fill: #FBF7EE; }
  .boat-flag { fill: var(--red, #D9452F); }
  .bird { fill: none; stroke: #4A5A68; stroke-width: 1.6; stroke-linecap: round; opacity: 0.5; }

  /* 市民：白描邊墊在底下，壓在草地上才看得清楚；襯衫顏色由 --cit 決定 */
  .cit-shadow { fill: #2E2A24; opacity: 0.2; }
  .cit-halo { fill: none; stroke: #FFFFFF; stroke-width: 4.2; stroke-linecap: round; opacity: 0.92; }
  .cit-leg { fill: none; stroke: #4A4038; stroke-width: 1.9; stroke-linecap: round; }
  .cit-arm { fill: none; stroke: var(--cit, #3B7CA8); stroke-width: 1.9; stroke-linecap: round; }
  .cit-body { fill: var(--cit, #3B7CA8); stroke: #FFFFFF; stroke-width: 1.2; paint-order: stroke; }
  .cit-head { fill: #F2C9A0; stroke: #FFFFFF; stroke-width: 1.2; paint-order: stroke; }
  .cit-hair { fill: #4A3A2E; }
  .f-red { fill: var(--red); }
  .f-orange { fill: var(--orange); }
  .f-green { fill: var(--green); }
  .f-blue { fill: var(--blue); }
  .f-s-red { stroke: var(--red); }
  .f-s-orange { stroke: var(--orange); }
  .f-s-green { stroke: var(--green); }
  .f-s-blue { stroke: var(--blue); }
  .f-s-magenta { stroke: var(--magenta); }
</style>
