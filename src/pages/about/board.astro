---

<BaseLayout title="歷屆理監事" description="台灣性諮商學會歷屆理事會、監事會與秘書處名單。">
  <PageHero
    breadcrumb={{ label: "關於我們", href: "/about" }}
    eyebrow="歷屆理監事"
    title="七屆以來，一起把學會撐起來的人"
  />

  <section class="section">
    <div class="wrap">
      <div class="term-list">
        {terms.map((t) => {
          const leader = t.members.find((m) => m.role === "理事長");
          return (
            <details class="term-card" open={t.current}>
              <summary>
                <span class="term-label">
                  第{numerals[t.term]}屆
                  {t.current && <span class="current-badge">現任</span>}
                </span>
                <span class="term-leader">理事長・{leader?.name}</span>
              </summary>
              <div class="member-grid">
                {t.members.map((m) => (
                  <div class="member-row">
                    <span class="member-role">{m.role}</span>
                    <span class="member-name">{m.name}</span>
                  </div>
                ))}
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 40px 0 56px;
  }

  .term-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .term-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }

  .term-card[open] {
    border-color: color-mix(in srgb, var(--blue) 35%, var(--line));
  }

  .term-card summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    flex-wrap: wrap;
  }

  .term-card summary::-webkit-details-marker {
    display: none;
  }

  .term-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .current-badge {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--blue-deep);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .term-leader {
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 4px 22px 20px;
  }

  @media (max-width: 560px) {
    .member-grid {
      grid-template-columns: 1fr;
    }
  }

  .member-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
  }

  .member-row:hover {
    background: var(--bg-alt);
  }

  .member-role {
    flex: 0 0 5.2em;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .member-name {
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--ink);
  }
</style>
