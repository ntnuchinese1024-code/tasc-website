---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import FigureRing from "../../../components/decor/FigureRing.astro";

export const groups = [
  {
    slug: "ethics",
    name: "倫理委員會",
    summary: "受理會員的倫理諮詢，處理性諮商實務中遇到的專業倫理疑義。",
  },
  {
    slug: "certification",
    name: "認證委員會",
    summary: "審核性諮商師的認證與換證申請，維持專業資格的把關標準。",
  },
  {
    slug: "pr",
    name: "公關組",
    summary: "對外發聲與合作聯繫，包含公開聲明、媒體溝通與跨機構合作。",
  },
  {
    slug: "course-promotion",
    name: "推廣課程組",
    summary: "規劃並推廣年度課程、講座與工作坊，是會員最常接觸到的一線窗口。",
  },
  {
    slug: "course-certification",
    name: "認證課程組",
    summary: "審核課程是否符合性諮商師認證／換證所需的時數與領域標準。",
  },
];

export function getStaticPaths() {
  return groups.map((g) => ({ params: { slug: g.slug }, props: g }));
}

const { name, summary } = Astro.props;
---

<BaseLayout title={name} description={`台灣性諮商學會 - ${name}`}>
  <PageHero eyebrow="關於我們・組織架構" eyebrowHref="/about#structure" title={name} />

  <section class="section">
    <div class="wrap prose">
      <p class="lead">{summary}</p>
      <div class="placeholder-note">
        <div class="placeholder-text">
          <p>這個小組的詳細運作方式（成員、聯繫窗口、近期工作）正在整理中，之後會補上。</p>
          <a href="/about#structure" class="btn btn-ghost">回組織架構</a>
        </div>
        <FigureRing class="placeholder-ring" variant="outline" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 44px 0 56px;
  }

  .lead {
    font-size: 1rem;
    color: var(--ink-soft);
    max-width: 56ch;
    margin: 0 0 28px;
  }

  .placeholder-note {
    background: var(--bg-alt);
    border: 1px dashed var(--line);
    border-radius: 14px;
    padding: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .placeholder-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .placeholder-note :global(.placeholder-ring) {
    width: 128px;
    height: 128px;
    flex: none;
    opacity: 0.55;
  }

  @media (max-width: 600px) {
    .placeholder-note {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }

  .placeholder-note p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
</style>
