---
/**
 * 公關組「同遊前網路串聯」活動頁：2026 臺灣同志遊行。
 *
 * 會員在這裡做自己的挺同圖卡（換頭貼、發文響應），可以把圖卡釘上同遊照片牆，
 * 並一鍵複製活動 hashtag。
 *
 * 金句與 hashtag 都在 src/data/pride-2026.ts。照片牆的資料在報名系統
 * （/api/pride-wall，後台 /admin/pride-wall 審核與開關）；報名系統把活動設成
 * 「籌備中」時，照片牆與「釘上照片牆」按鈕會自動消失，這一頁其他部分照常。
 *
 * ── 目前是「內部試閱」狀態 ──────────────────────────────
 * 放在公關組底下一個沒有任何連結指過來的網址，給理監事先看：
 *   https://tasctaiwan.tw/about/groups/pr/pride-preview
 * 並且設了 noindex、從 sitemap 排除（astro.config.mjs），搜尋引擎不會收錄。
 *
 * 正式對外公開時：
 *   1. 把這個檔案搬到 src/pages/pride.astro（網址變成 /pride），import 路徑改回 ../
 *   2. 拿掉下面 BaseLayout 的 noindex，並刪掉 astro.config.mjs 裡排除 pride-preview 的那段
 *   3. 在 public/llms.txt「參與學會」加一行介紹
 *
 * 遊行結束後想撤掉：刪掉這個檔案即可。
 */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageHero from "../../../../components/PageHero.astro";
import PrideCardMaker from "../../../../components/PrideCardMaker.astro";
import PrideWall from "../../../../components/PrideWall.astro";
import { coreHashtags, extraHashtags, captionTemplate, parade } from "../../../../data/pride-2026";
---

<BaseLayout
  noindex
  title="我挺同我驕傲・2026 臺灣同志遊行圖卡"
  description="台灣性諮商學會邀請你一起響應 2026 臺灣同志遊行：放一張照片、選個版型、抽一句話，做一張自己的挺同圖卡，也可以夾上同遊照片牆。"
>
  <PageHero
    eyebrow="公關組・同遊前網路串聯"
    title="做一張你的挺同圖卡"
    lead="放一張照片、選個版型、抽一句話，一分鐘就能做好。換上大頭貼、發文響應，或夾上同遊照片牆——10 月 31 日，我們在遊行現場見。"
  />

  <section class="section">
    <div class="wrap">
      <PrideCardMaker />
    </div>
  </section>

  <PrideWall />

  <section class="section section-alt">
    <div class="wrap wrap-narrow">
      <h2>發文時帶上這些 Hashtag</h2>
      <p class="section-lead">點一下就能複製，貼進 Facebook 或 Instagram 的貼文裡。</p>

      <div class="tag-card">
        <p class="tag-label">活動指定</p>
        <div class="tags">
          {coreHashtags.map((t) => <button type="button" class="tag" data-copy={t}>{t}</button>)}
        </div>
        <p class="tag-label">也可以加上</p>
        <div class="tags">
          {extraHashtags.map((t) => <button type="button" class="tag tag-soft" data-copy={t}>{t}</button>)}
        </div>
        <div class="tag-actions">
          <button type="button" class="btn btn-primary" data-copy={coreHashtags.join(" ")}>複製活動指定 Hashtag</button>
        </div>
      </div>

      <div class="tag-card">
        <p class="tag-label">發文範本</p>
        <pre class="caption">{captionTemplate}</pre>
        <div class="tag-actions">
          <button type="button" class="btn btn-ghost" data-copy={captionTemplate}>複製發文範本</button>
        </div>
      </div>

      <p class="copy-status" data-copy-status aria-live="polite"></p>
      <textarea class="manual-copy" data-manual-copy readonly rows="3" hidden aria-label="要複製的文字"></textarea>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      <h2>一起走上街頭</h2>
      <p class="section-lead">
        第 24 屆臺灣同志遊行將於 {parade.date}在{parade.place}舉行，今年的主題是「聲做伙聽，路做伙行」。
        免報名，當天直接到現場就能加入。詳細流程與路線請見
        <a href={parade.url} target="_blank" rel="noopener">遊行官方網站</a>。
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const status = document.querySelector<HTMLElement>("[data-copy-status]")!;
  const manual = document.querySelector<HTMLTextAreaElement>("[data-manual-copy]")!;
  let timer = 0;

  /**
   * 舊式複製：在點擊的當下「同步」選取文字再複製。
   *
   * 一定要同步、而且要先試這個：LINE、FB 的內建瀏覽器和 iPhone 只承認
   * 「使用者剛點下去那一瞬間」的複製。如果先 await 新式的 clipboard API、
   * 等它失敗才退回這裡，那一瞬間已經過了，會安靜地什麼都沒複製到。
   */
  function legacyCopy(text: string): boolean {
    const ta = document.createElement("textarea");
    ta.value = text;
    // 16px 以上 iPhone 才不會自動放大畫面；不設 readonly，iPhone 才選得起來
    ta.style.cssText = "position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;";
    document.body.append(ta);
    ta.focus();
    ta.setSelectionRange(0, text.length);
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    ta.remove();
    return ok;
  }

  async function copy(text: string): Promise<boolean> {
    if (legacyCopy(text)) return true;
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  /** 兩種方法都失敗：把文字放在看得到的框裡、先幫忙選好，讓人長按自己拷貝 */
  function showManual(text: string) {
    manual.value = text;
    manual.hidden = false;
    manual.focus();
    manual.setSelectionRange(0, text.length);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy!;
      const ok = await copy(text);
      const original = btn.dataset.label ?? btn.textContent!;
      btn.dataset.label = original;
      btn.textContent = ok ? "已複製 ✓" : original;
      status.classList.toggle("is-error", !ok);
      if (ok) {
        status.textContent = "已複製到剪貼簿，可以直接貼到貼文裡。";
        manual.hidden = true;
      } else {
        status.textContent = "這個瀏覽器不讓網頁直接複製。文字已經放在下面並選好了，請長按選「拷貝」。";
        showManual(text);
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        document.querySelectorAll<HTMLButtonElement>("[data-copy][data-label]").forEach((b) => {
          b.textContent = b.dataset.label!;
        });
        if (ok) status.textContent = "";
      }, 2500);
    });
  });
</script>

<style>
  .section {
    padding: 44px 0;
  }

  .section-alt {
    background: var(--card);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .wrap-narrow {
    max-width: 760px;
  }

  .section h2 {
    font-size: clamp(1.1rem, 3vw, 1.3rem);
    margin-bottom: 20px;
  }

  .section-lead {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.8;
    margin: -8px 0 22px;
  }

  .section-lead a {
    color: var(--blue-deep);
    font-weight: 700;
  }

  .tag-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 22px;
    margin-bottom: 16px;
  }

  .tag-label {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .tags + .tag-label {
    margin-top: 18px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    border: 0;
    border-radius: 999px;
    padding: 8px 14px;
    background: var(--magenta-deep);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }

  .tag-soft {
    background: var(--card);
    color: var(--ink-soft);
    border: 1.5px solid var(--line);
  }

  .tag:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  .tag-actions {
    margin-top: 18px;
  }

  .btn {
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .btn-ghost {
    background: transparent;
    border: 1.5px solid var(--ink);
  }

  .caption {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .copy-status {
    min-height: 1.5em;
    margin: 0;
    font-size: 0.85rem;
    color: var(--green-deep);
    font-weight: 600;
  }

  .copy-status.is-error {
    color: var(--red-deep);
  }

  .manual-copy {
    width: 100%;
    margin-top: 8px;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font: inherit;
    font-size: 16px;
    background: var(--card);
    resize: none;
  }
</style>
