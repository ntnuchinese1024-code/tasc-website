---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocAccordion from "../../components/DocAccordion.astro";
import PageHero from "../../components/PageHero.astro";
import { ethicsChapters, revisionHistory } from "../../data/ethics-code";

// 條文本體在 src/data/ethics-code.ts，這裡只負責把它排出來
const sections = ethicsChapters.map((c) => ({
  title: `${c.num}　${c.title}`,
  color: `var(--${c.color})`,
  colorText: `var(--${c.color}-deep)`,
  lead: c.lead,
  items: c.items,
  groups: c.subsections,
}));
---

<BaseLayout title="性諮商師倫理規範" description="台灣性諮商學會專業倫理守則全文，含總則、倫理程序與五項行為守則原則。">
  <PageHero
    breadcrumb={{ label: "性諮商師", href: "/counselors" }}
    eyebrow="倫理規範"
    title="台灣性諮商學會專業倫理守則"
    lead="本守則是成為會員的條件，適用於所有會員。以下為全文，分總則、倫理程序、行為守則三章，行為守則再分為五項原則。"
  />

  <section class="section">
    <div class="wrap">
      <DocAccordion sections={sections} />

      <details class="history">
        <summary>修訂沿革</summary>
        <ol>
          {revisionHistory.map((r) => <li>{r}</li>)}
        </ol>
      </details>

      <div class="contact-note">
        <p>台灣性諮商學會聯繫方式</p>
        <p>會址：231 新北市新店區北新路一段337號2樓　電話：02-2914-3527　E-MAIL：tasc.tw@gmail.com</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 44px 0 56px;
  }

  .history {
    margin-top: 32px;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 4px 20px;
  }

  .history summary {
    padding: 12px 0;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .history ol {
    margin: 0 0 16px;
    padding-left: 20px;
    font-size: 0.84rem;
    color: var(--ink-faint);
    line-height: 1.9;
  }

  .contact-note {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .contact-note p {
    margin: 0 0 4px;
  }
</style>
