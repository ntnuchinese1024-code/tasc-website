---
import BaseLayout from "../layouts/BaseLayout.astro";
import FigureRing from "../components/decor/FigureRing.astro";
import FigureMark from "../components/decor/FigureMark.astro";
import ArcField from "../components/decor/ArcField.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import AnniversaryBanner from "../components/AnniversaryBanner.astro";
import { wrapHeadingHtml } from "../lib/wrap-heading";
import {
  getOpenCourses,
  accentVars,
  formatPriceSummary,
} from "../lib/registration-api";

const pillars = [
  {
    color: "var(--blue)",
    colorText: "var(--blue-deep)",
    title: "推廣性諮商、性教育專業工作",
    body: "促進社會大眾對性諮商及性教育之知識及態度。",
  },
  {
    color: "var(--red)",
    colorText: "var(--red-deep)",
    title: "辦理專業訓練課程",
    body: "培訓專業人員，提升性諮商服務品質。",
  },
  {
    color: "var(--magenta)",
    colorText: "var(--magenta-deep)",
    title: "增進專業人員聯繫合作",
    body: "凝聚性諮商相關工作者的交流與支持網絡。",
  },
  {
    color: "var(--green)",
    colorText: "var(--green-deep)",
    title: "建立專業倫理基準",
    body: "維持性諮商領域可信賴的實務標準。",
  },
];

// 首頁只放最近三堂還沒開始的課，內容來自報名系統後台。
// 秘書處在後台發布課程，這裡就會跟著換，不需要有人記得回來改首頁——
// 首頁掛著已經上完的課，是最容易發生也最傷信任的一種過期。
const todayStart = new Date(
  new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Taipei" }).format(new Date()) + "T00:00:00+08:00",
);

const events = (await getOpenCourses())
  .filter((course) => course.starts_at === null || new Date(course.starts_at) >= todayStart)
  .slice(0, 3)
  .map((course) => {
    const vars = accentVars(course.accent);
    return {
      color: vars.color,
      colorText: vars.text,
      tag: course.instructor ? `講師・${course.instructor}` : "課程",
      date: course.starts_at
        ? new Intl.DateTimeFormat("zh-TW", {
            timeZone: "Asia/Taipei",
            month: "long",
            day: "numeric",
            weekday: "narrow",
          }).format(new Date(course.starts_at))
        : "時間另行公告",
      title: course.title,
      body: course.description ?? "",
      meta: formatPriceSummary(course.price, course.price_tiers),
      href: `/news/upcoming/${course.slug}`,
    };
  });
---

<BaseLayout title="首頁" description="台灣性諮商學會由一群關心性諮商發展的性諮商師、心理師與相關專業人士組成，推動性諮商之專業發展。">
  <header class="hero">
    <div class="wrap hero-wrap">
      <FigureRing class="decor-layer hero-ring" />
      <div class="hero-inner">
        <span class="eyebrow">TASC・台灣性諮商學會</span>
        <h1 set:html={wrapHeadingHtml("集結性議題專長的心理師，共同促進台灣社會的性健康福祉")} />
        <p class="lead">
          台灣性諮商學會由一群關心性諮商發展的性諮商師、心理師與相關專業人士組成，建構全人性發展觀點的性諮商領域，關注從幼兒到老人、一般發展到各類特殊族群的性議題。
        </p>
        <div class="hero-actions">
          <a href="/counselors/certification" class="btn btn-primary">認識性諮商師認證</a>
          <a href="/news" class="btn btn-ghost">查看近期課程</a>
        </div>
      </div>
    </div>
  </header>

  {/* 2026 會慶橫幅。活動結束、典藏一段時間之後想撤掉，把這一行刪掉就好。 */}
  <AnniversaryBanner />

  <section class="pillars">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">使命與任務</span>
        <h2>我們持續在做的四件事</h2>
      </div>
      <div class="pillar-grid">
        {pillars.map((p, i) => (
          <div class="pillar" style={`--dot: ${p.color}; --dot-text: ${p.colorText}`}>
            <FigureMark class="decor-layer pillar-mark" color={p.color} />
            <span class="num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="intro-video">
    <div class="wrap">
      <div class="video-layout">
        <div class="video-copy">
          <span class="eyebrow">認識性諮商</span>
          <h2>性諮商師到底在做什麼？</h2>
          <p>
            性諮商是一門需要經由專門訓練的專業。這支影片從實務工作的角度，
            說明性諮商師如何陪伴當事人談論性議題，以及這份工作與一般
            心理諮商的異同。
          </p>
          <a href="/counselors" class="more">認識性諮商師認證 →</a>
        </div>

        <VideoEmbed
          class="video-media"
          videoId="2MQnFY7w24g"
          title="【直擊!】一窺專業又神秘的職業！──性諮商師"
          poster="/images/video/sex-counseling-intro.jpg"
          source="荷光性諮商專業訓練中心"
          sourceUrl="https://www.youtube.com/@beoneplace"
        />
      </div>
    </div>
  </section>

  <section class="events">
    <ArcField class="decor-layer events-arcs" weight={2.4} />
    <div class="wrap decor-above">
      <div class="section-head events-head">
        <div>
          <span class="eyebrow">近期課程</span>
          <h2>最新消息</h2>
        </div>
        <a href="/news" class="more">查看全部 →</a>
      </div>
      <div class="event-grid">
        {events.length === 0 && (
          <p class="event-empty">目前沒有公告中的課程，歡迎關注學會臉書粉絲專頁或稍後再回來看看。</p>
        )}
        {events.map((e) => (
          <a class="event-card" href={e.href} style={`--dot: ${e.color}; --dot-text: ${e.colorText}`}>
            <span class="event-tag">{e.tag}</span>
            <span class="event-date">{e.date}</span>
            <h3 set:html={wrapHeadingHtml(e.title)} />
            <p>{e.body}</p>
            <div class="event-meta">{e.meta}</div>
            <span class="event-register">課程詳情與報名 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 48px 0 40px;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .hero-wrap {
    position: relative;
  }

  /* 標題欄最寬 42rem，內容欄最寬 1080px，右邊本來就空著一大塊，三人環放這裡 */
  .hero :global(.hero-ring) {
    width: 300px;
    height: 300px;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  @media (min-width: 1000px) {
    /* 環佔掉右邊約 300px，文字欄要讓開才不會壓在一起 */
    .hero-inner {
      max-width: 38rem;
    }
  }

  .hero .eyebrow {
    display: block;
    margin-bottom: 14px;
    color: var(--blue-deep);
  }

  .hero h1 {
    /* Each clause is locked with white-space:nowrap (see wrapHeadingHtml), so
       the font size must stay small enough that the longest clause never
       exceeds the viewport width, or it will get clipped instead of wrapping. */
    font-size: clamp(1.1rem, 5.6vw, 2.5rem);
    line-height: 1.48;
    font-weight: 800;
  }

  .hero .lead {
    margin: 18px 0 26px;
    color: var(--ink-soft);
    font-size: 1rem;
    max-width: 46rem;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .hero {
      padding-top: 40px;
    }
    /* 手機版標題會佔滿整個寬度，實心的環壓上去會擋到字，所以這裡直接收掉。 */
    .hero :global(.hero-ring) {
      display: none;
    }
  }

  @media (min-width: 701px) {
    .hero h1 {
      line-height: 1.42;
    }
  }

  .section-head {
    margin-bottom: 28px;
  }

  .section-head .eyebrow {
    display: block;
    margin-bottom: 8px;
  }

  .section-head h2 {
    font-size: clamp(1.15rem, 3vw, 1.4rem);
  }

  .events-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .events-head .more {
    font-size: 0.86rem;
    color: var(--blue-deep);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .pillars {
    padding: 48px 0;
    background: var(--card);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .pillar {
    position: relative;
    overflow: hidden;
    padding: 18px 18px 20px;
    border-radius: 12px;
    border-top: 3px solid var(--dot);
    background: color-mix(in srgb, var(--dot) 6%, var(--card));
  }

  /* 卡片自己的顏色畫一個人形當底紋，讓四張卡片不只是四個色塊 */
  .pillar :global(.pillar-mark) {
    width: 96px;
    right: -18px;
    bottom: -14px;
    opacity: 0.14;
  }

  .pillar .num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--dot-text);
    display: block;
    margin-bottom: 8px;
  }

  .pillar h3 {
    font-size: 0.96rem;
    margin-bottom: 6px;
    line-height: 1.55;
    font-weight: 700;
  }

  .pillar p {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .intro-video {
    padding: 48px 0;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
  }

  .video-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 32px;
    align-items: center;
  }

  .video-copy .eyebrow {
    display: block;
    margin-bottom: 8px;
    color: var(--magenta-deep);
  }

  .video-copy h2 {
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    margin-bottom: 12px;
  }

  .video-copy p {
    margin: 0 0 16px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .video-copy .more {
    font-size: 0.86rem;
    color: var(--blue-deep);
    text-decoration: none;
    font-weight: 700;
  }

  .video-copy .more:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    /* 窄螢幕改成上下排：先講這是什麼，再放影片 */
    .video-layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }

  .events {
    position: relative;
    overflow: hidden;
    padding: 48px 0 56px;
  }

  /* 卡片右邊在寬螢幕上會留白，用標誌那圈弧線的「回音」墊底 */
  .events :global(.events-arcs) {
    width: 460px;
    height: 460px;
    top: -120px;
    right: -170px;
    opacity: 0.16;
  }

  @media (max-width: 860px) {
    .events :global(.events-arcs) {
      width: 300px;
      height: 300px;
      right: -140px;
      opacity: 0.12;
    }
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .event-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--dot);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .event-card:hover {
    border-color: var(--dot);
    transform: translateY(-2px);
  }

  .event-card:focus-visible {
    outline: 2px solid var(--dot-text);
    outline-offset: 2px;
  }

  .event-register {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--dot-text);
  }

  .event-empty {
    grid-column: 1 / -1;
    font-size: 0.88rem;
    color: var(--ink-soft);
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 12px;
    padding: 24px;
    margin: 0;
  }

  .event-tag {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--dot-text);
    background: color-mix(in srgb, var(--dot) 14%, var(--card));
    padding: 3px 10px;
    border-radius: 999px;
  }

  .event-date {
    font-size: 0.76rem;
    color: var(--ink-faint);
    font-weight: 700;
  }

  .event-card h3 {
    font-size: 1rem;
    line-height: 1.55;
    font-weight: 700;
  }

  .event-card p {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .event-meta {
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
  }

  @media (max-width: 860px) {
    .pillar-grid {
      grid-template-columns: 1fr 1fr;
    }
    .event-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
