---
/**
 * /island ——「政策島嶼」：把 115 年度的新發展畫成一片串聯起來的群島。
 *
 * 島上有什麼、文案、座標都在 `src/data/island-2026.ts`；地圖本體（SVG、說明卡、
 * 下方清單）在 `src/components/island/IslandMap.astro`，電子報那一期共用同一個元件。
 *
 * 目前是**內部預覽**：設了 noindex、也從 sitemap 排除、還沒掛進主選單。
 * 等理監事看過、定稿之後，再把 noindex 拿掉並加進 Header 的 navLinks。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import IslandMap from "../components/island/IslandMap.astro";
import { landmarks, regions, routes, islandMeta } from "../data/island-2026";

const title = `${islandMeta.year}${islandMeta.title}｜台灣性諮商學會`;
const description = islandMeta.lead;
---

<BaseLayout title={title} description={description} noindex={true}>
  <PageHero
    eyebrow={`${islandMeta.year}・內部預覽`}
    title={islandMeta.title}
    lead={islandMeta.lead}
    decor={false}
  />

  <IslandMap meta={islandMeta} regions={regions} routes={routes} landmarks={landmarks} />
</BaseLayout>
