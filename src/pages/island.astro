  .index-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    font-family: inherit;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--lm-color);
    border-radius: 12px;
    padding: 14px 16px 16px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .index-card:hover,
  .index-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .index-card.is-active {
    border-color: var(--lm-deep);
    border-left-color: var(--lm-deep);
    box-shadow: var(--shadow);
  }

  .index-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.7rem;
    color: var(--ink-faint);
    font-weight: 700;
  }

  .index-kind {
    color: var(--lm-deep);
  }

  .index-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .index-summary {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .lm-lift,
    .index-card {
      transition: none;
    }

    .walker-bob {
      animation: none;
    }
  }
</style>

<script>
  // 點地標（或下面的清單）就換右邊的說明卡。純瀏覽器端切換顯示，沒有重新載入。
  const stage = document.querySelector("[data-island]");
  const jumps = Array.from(document.querySelectorAll<HTMLElement>("[data-jump]"));

  if (stage) {
    const marks = Array.from(stage.querySelectorAll<SVGGElement>(".lm"));
    const cards = Array.from(stage.querySelectorAll<HTMLElement>("[data-card]"));

    const select = (id: string | undefined) => {
      if (!id) return;
      marks.forEach((m) => m.classList.toggle("is-active", m.dataset.id === id));
      cards.forEach((c) => {
        c.hidden = c.dataset.card !== id;
      });
      jumps.forEach((j) => j.classList.toggle("is-active", j.dataset.jump === id));
    };

    marks.forEach((m) => {
      m.addEventListener("click", () => select(m.dataset.id));
      m.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          select(m.dataset.id);
        }
      });
    });

    jumps.forEach((j) => {
      j.addEventListener("click", () => {
        select(j.dataset.jump);
        // 手機版說明卡在地圖下面，捲回地圖才看得到切換結果
        stage.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // 網址帶錨點（例如 /island#directory）就直接選那一個
    const fromHash = window.location.hash.slice(1);
    if (fromHash && marks.some((m) => m.dataset.id === fromHash)) select(fromHash);

    // 白天／黃昏／夜晚：只是在地圖上換一個 class，顏色都由 CSS 變數決定
    const map = stage.querySelector<HTMLElement>(".island-map");
    const modeBtns = Array.from(stage.querySelectorAll<HTMLButtonElement>("[data-mode]"));
    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode;
        map?.classList.toggle("is-dusk", mode === "dusk");
        map?.classList.toggle("is-night", mode === "night");
        modeBtns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-pressed", String(on));
        });
      });
    });

    // 走動的人是 SVG 的 SMIL 動畫，CSS 的 prefers-reduced-motion 關不掉它，要用 JS 停。
    const svg = stage.querySelector("svg");
    if (svg && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      (svg as SVGSVGElement).pauseAnimations();
    }
  }
</script>
