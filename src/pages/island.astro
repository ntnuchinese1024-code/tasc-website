    stroke: #8E2C1E;
    stroke-width: 1.2;
  }

  /* ---- 夜色與燈光 ---------------------------------------------------- */

  /* 只罩住地形（房子、燈、建築都畫在它上面，夜裡才亮得起來） */
  .night-tint path {
    fill: #0A2440;
    opacity: var(--night);
    transition: opacity 0.45s ease;
  }

  .lamp-halo {
    fill: #FFD98A;
    opacity: calc(var(--lamp) * 0.7);
    transition: opacity 0.45s ease;
  }

  .lamp-bulb {
    fill: #FFEBBC;
    opacity: calc(0.35 + var(--lamp) * 0.65);
    transition: opacity 0.45s ease;
  }

  .lamp-post {
    fill: none;
    stroke: #6B6558;
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .home-shade {
    fill: #2F5C2A;
    opacity: 0.18;
  }

  .island-name {
    font-family: var(--font-display);
    /* 底下墊一圈白：島名偶爾會疊到別座島或海面 */
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 6;
    stroke-linejoin: round;
    font-size: 21px;
    font-weight: 700;
    fill: var(--lm-deep);
    text-anchor: middle;
    letter-spacing: 0.08em;
  }

  /* ---- 樹（顏色由每座島的 --tree 決定） ------------------------------ */

  .tree-lit {
    fill: var(--tree);
  }

  .tree-dark {
    fill: var(--tree-dark);
  }

  .tree-trunk {
    fill: none;
    stroke: #8A6A45;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .palm-trunk {
    fill: none;
    stroke: #9A7348;
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  .palm-frond {
    fill: none;
    stroke: var(--tree);
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  .tree-shade {
    fill: #2F5C2A;
    opacity: 0.2;
  }

  /* ---- 走動的人 ------------------------------------------------------ */

  .walker-bob {
    animation: bob 0.85s ease-in-out infinite alternate;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  @keyframes bob {
    from {
      transform: translateY(0) scaleY(1);
    }
    to {
      transform: translateY(-1.6px) scaleY(1.04);
    }
  }

  /* ---- 地標 ---------------------------------------------------------- */

  .lm {
    cursor: pointer;
    outline: none;
  }

  .lm-shadow {
    fill: #241C14;
    opacity: 0.18;
  }

  /* 選到的時候才會出現的地面光圈 */
  .lm-ring {
    fill: none;
    stroke: var(--lm-deep);
    stroke-width: 2.4;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .lm-lift {
    transition: transform 0.18s ease;
  }

  /* 整個地標都可以點：建築本身有縫，光靠圖形會點不到 */
  .lm-hit {
    fill: transparent;
  }

  .lm-chip {
    fill: #fff;
    stroke: rgba(0, 0, 0, 0.06);
    stroke-width: 1;
  }

  /* 膠囊底下墊一片，當作落影 */
  .lm-chip-shadow {
    fill: #0E3C55;
    opacity: 0.18;
  }

  .lm-dot {
    fill: var(--lm-color);
  }

  .lm-label text {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    fill: var(--ink);
    text-anchor: start;
  }

  .lm {
    cursor: pointer;
  }

  .lm:hover .lm-lift,
  .lm:focus-visible .lm-lift,
  .lm.is-active .lm-lift {
    transform: translateY(-7px);
  }

  .lm:hover .lm-ring,
  .lm:focus-visible .lm-ring,
  .lm.is-active .lm-ring {
    opacity: 0.8;
  }

  .lm:focus-visible .lm-chip {
    stroke: var(--lm-deep);
    stroke-width: 2;
  }

  .walker-shade {
    fill: #2F5C2A;
    opacity: 0.18;
  }

  .lm-blue { --lm-color: var(--blue); --lm-deep: var(--blue-deep); }
  .lm-red { --lm-color: var(--red); --lm-deep: var(--red-deep); }
  .lm-green { --lm-color: var(--green); --lm-deep: var(--green-deep); }
  .lm-orange { --lm-color: var(--orange); --lm-deep: var(--orange-deep); }
  .lm-magenta { --lm-color: var(--magenta); --lm-deep: var(--magenta-deep); }

  /* ---- 說明卡 -------------------------------------------------------- */

  .island-panel {
    position: sticky;
    top: 24px;
  }

  .lm-card {
