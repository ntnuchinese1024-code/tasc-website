  /* ---- 下方清單 ------------------------------------------------------ */

  .island-index {
    padding: 40px 0 72px;
  }

  .index-group + .index-group {
    margin-top: 32px;
  }

  .index-title {
    font-size: 1.3rem;
    margin-bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    padding-left: 14px;
    border-left: 5px solid var(--lm-color);
