---

<BaseLayout title="最新消息" description="台灣性諮商學會近期與歷年課程、講座、年會活動公告。">
  <PageHero
    eyebrow="最新消息"
    title="近期課程與活動"
    lead="會員身分享有課程優惠價，報名前請確認當年度會費是否已繳交。"
  >
    <div class="hero-links">
      <a href="/annual">年會專區 →</a>
      <a href="/news/reports">課程報導 →</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <h2>近期活動</h2>
      <div class="event-grid">
        {upcoming.map((e) => {
          const Tag = e.href ? "a" : "article";
          return (
            <Tag class="event-card" href={e.href} style={`--dot: ${e.color}; --dot-text: ${e.colorText}`}>
              <span class="event-tag">{e.tag}</span>
              <span class="event-date">{e.date}</span>
              <h3 set:html={wrapHeadingHtml(e.title)} />
              <p>{e.body}</p>
              <div class="event-meta">{e.meta}</div>
              {e.href && <span class="event-register">線上報名 →</span>}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>已結束的活動</h2>
      <div class="event-grid">
        {past.map((e) => (
          <article class="event-card is-past" style={`--dot: ${e.color}; --dot-text: ${e.colorText}`}>
            <span class="event-tag">{e.tag}</span>
            <span class="event-date">{e.date}</span>
            <h3 set:html={wrapHeadingHtml(e.title)} />
            <p>{e.body}</p>
            <div class="event-meta">{e.meta}</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-links {
    display: flex;
    gap: 16px;
  }

  .hero-links a {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--blue-deep);
    text-decoration: none;
  }

  .hero-links a:hover {
    text-decoration: underline;
  }

  .section {
    padding: 44px 0;
  }

  .section-alt {
    background: var(--card);
    border-top: 1px solid var(--line);
  }

  .section h2 {
    font-size: clamp(1.1rem, 3vw, 1.3rem);
    margin-bottom: 20px;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 860px) {
    .event-grid {
      grid-template-columns: 1fr;
    }
  }

  .event-card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-left: 4px solid var(--dot);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  a.event-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .event-register {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--dot-text);
  }

  .section-alt .event-card {
    background: var(--bg-alt);
  }

  .event-card.is-past {
    opacity: 0.82;
  }

  .event-tag {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--dot-text);
    background: color-mix(in srgb, var(--dot) 14%, var(--card));
    padding: 3px 10px;
    border-radius: 999px;
  }

  .event-date {
    font-size: 0.76rem;
    color: var(--ink-faint);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .event-card h3 {
    font-size: 0.98rem;
    line-height: 1.55;
    font-weight: 700;
  }

  .event-card p {
    font-size: 0.84rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.65;
  }

  .event-meta {
    font-size: 0.76rem;
    color: var(--ink-faint);
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
  }
</style>
