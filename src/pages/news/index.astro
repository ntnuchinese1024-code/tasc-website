---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CoursePoster from "../../components/CoursePoster.astro";
import { wrapHeadingHtml } from "../../lib/wrap-heading";
import {
  getOpenCourses,
  accentVars,
  formatEventTime,
  formatPriceSummary,
  type EventSummary,
} from "../../lib/registration-api";

interface EventItem {
  date: string;
  sortKey: string;
  tag: string;
  color: string;
  colorText: string;
  title: string;
  body: string;
  meta: string;
  href?: string;
  /** 課程海報，放在 public/images/courses/ 底下；沒有海報就不用寫這一行 */
  poster?: string;
}

// ---------------------------------------------------------------------------
// 課程一律來自報名系統後台
// ---------------------------------------------------------------------------
// 秘書處在後台按下發布，這一頁就會自動多一張卡片，不需要改這個檔案。
// 原本手寫在這裡的三堂課（8/16、8/22、9/5）已經搬進資料庫，所以陣列清空了。
// 「已結束的活動」那一區還留著更早以前的手寫紀錄，那些沒有報名資料，
// 就讓它們留在檔案裡；日後想搬也是一次搬一堂，兩種來源可以並存。

/** 把報名系統的課程轉成這一頁既有的卡片格式，讓兩種來源共用同一套版面。 */
function toEventItem(course: EventSummary): EventItem {
  const vars = accentVars(course.accent);
  const dateLabel = course.starts_at
    ? new Intl.DateTimeFormat("zh-TW", {
        timeZone: "Asia/Taipei",
        month: "long",
        day: "numeric",
        weekday: "narrow",
      }).format(new Date(course.starts_at))
    : "時間另行公告";

  const seats =
    course.registration.status === "OPEN"
      ? course.registration.remaining === null
        ? "" // 秘書處選擇不公開人數
        : `尚餘 ${course.registration.remaining} 位`
      : course.registration.status === "FULL"
        ? "名額已滿"
        : "";

  return {
    date: dateLabel,
    sortKey: course.starts_at ? course.starts_at.slice(0, 10) : "9999-12-31",
    tag: course.instructor ? `講師・${course.instructor}` : "課程",
    color: vars.color,
    colorText: vars.text,
    title: course.title,
    body: course.description ?? "",
    meta: [
      formatEventTime(course.starts_at, course.ends_at),
      course.location,
      formatPriceSummary(course.price, course.price_tiers),
      seats,
    ]
      .filter(Boolean)
      .join("・"),
    href: `/news/upcoming/${course.slug}`,
    poster: course.poster_url ?? undefined,
  };
}

// 課程結束之後不會馬上從後台下架（要留著寫課程報導），
// 所以在這裡依開課時間分流：還沒開始的放「近期活動」，已經上完的直接歸到下面那一區。
// 判斷用當天凌晨而不是「此刻」，當天的課整天都還留在近期活動裡。
const dbCourses = await getOpenCourses();
const todayStart = new Date(
  new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Taipei" }).format(new Date()) + "T00:00:00+08:00",
);

const isFinished = (course: EventSummary) =>
  course.starts_at !== null && new Date(course.starts_at) < todayStart;

const upcoming: EventItem[] = dbCourses
  .filter((c) => !isFinished(c))
  .map(toEventItem)
  .sort((a, b) => a.sortKey.localeCompare(b.sortKey));

const dbFinished: EventItem[] = dbCourses.filter(isFinished).map(toEventItem);

const handWrittenPast: EventItem[] = [
  {
    date: "8月15日（六）",
    sortKey: "2026-08-15",
    poster: "/images/courses/2026-08-15-寄養家庭性議題.jpg",
    tag: "實體工作坊",
    color: "var(--magenta)",
    colorText: "var(--magenta-deep)",
    title: "寄養家庭中的性議題：理解、陪伴與合作實務",
    body: "從第一線實務經驗出發，分享心理師如何理解寄養家庭中的兒少性發展脈絡，以及如何與寄養家長、社工建立合作模式。",
    meta: "講師 王嘉琪",
  },
  {
    date: "8月7日（五）",
    sortKey: "2026-08-07",
    poster: "/images/courses/2026-08-07-夜遊三流艋舺.jpg",
    tag: "走讀活動",
    color: "var(--orange)",
    colorText: "var(--orange-deep)",
    title: "夜遊三流艋舺：流氓、流鶯、流浪漢",
    body: "從捷運龍山寺站出發，走過新富町與剝皮寮，深入西昌街與鑽石大樓的性產業現場，凝視主流邊緣的「三流文化」。",
    meta: "講師 CL經紀人、李翊平",
  },
  {
    date: "6月6日（六）",
    sortKey: "2026-06-06",
    poster: "/images/annual/2026-年會-性諮商佇台灣.jpg",
    tag: "年度大會",
    color: "var(--blue)",
    colorText: "var(--blue-deep)",
    title: "2026台灣性諮商學會年會暨主題式工作坊：性諮商，佇台灣",
    body: "三場專題講座：台語與在地性別實踐對話、心智障礙者性議題的能力建構、性侵受害者的創傷與主體性。",
    meta: "台北市中山區松江路101號4樓",
  },
  {
    date: "5月3日（日）",
    sortKey: "2026-05-03",
    poster: "/images/courses/2026-05-03-個案性產業探索.jpg",
    tag: "線上講座",
    color: "var(--green)",
    colorText: "var(--green-deep)",
    title: "個案・性產業探索：性諮商實務中需面對的真實世界之一",
    body: "了解性產業結構和性病防治、台灣性產業地圖，以及性病防治和情感替代的迷思。",
    meta: "講師 金派經紀人 CL",
  },
  {
    date: "4月19日",
    sortKey: "2026-04-19",
    poster: "/images/courses/2026-04-19-倫理沙龍.jpg",
    tag: "會員限定",
    color: "var(--magenta)",
    colorText: "var(--magenta-deep)",
    title: "性諮商倫理的藝術與邊界：實務工作者的互動沙龍",
    body: "邀請五位在性諮商領域深耕的實務工作者，以互動沙龍形式討論性諮商實務現場中「卡卡的」倫理狀態。",
    meta: "講師 薛卉芝、李翊平、林榮哲、林沛辰、陳慧珊",
  },
  {
    date: "1月11日（日）",
    sortKey: "2026-01-11",
    poster: "/images/courses/2026-01-11-性需求不同步.jpg",
    tag: "線上講座",
    color: "var(--red)",
    colorText: "var(--red-deep)",
    title: "你想要、我不想要——當性需求不同步時該怎麼辦",
    body: "透過心理學觀點＋NLP 技術，理解伴侶性需求落差的背後密碼，學會用「理解彼此需求」取代「爭執誰對誰錯」。",
    meta: "講師 許庭韶",
  },
];

// 資料庫版本優先：同一堂課若兩邊都有，以後台的為準（點得進去、之後也會有報導）。
const pastHrefs = new Set(dbFinished.map((e) => e.href));
const past: EventItem[] = [...dbFinished, ...handWrittenPast.filter((e) => !pastHrefs.has(e.href))].sort(
  (a, b) => b.sortKey.localeCompare(a.sortKey),
);
---

<BaseLayout title="最新消息" description="台灣性諮商學會近期與歷年課程、講座、年會活動公告。">
  <PageHero
    eyebrow="最新消息"
    title="近期課程與活動"
    lead="會員身分享有課程優惠價，報名前請確認當年度會費是否已繳交。"
  >
    <div class="hero-links">
      <a href="/annual">年會專區 →</a>
      <a href="/news/reports">課程報導 →</a>
      <a href="/news/lectures">歷年講座 →</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <h2>近期活動</h2>
      <div class="event-grid">
        {upcoming.map((e) => {
          const Tag = e.href ? "a" : "article";
          return (
            <Tag class="event-card" href={e.href} style={`--dot: ${e.color}; --dot-text: ${e.colorText}`}>
              {e.poster && (
                <CoursePoster src={e.poster} alt={`${e.title} 課程海報`} variant="thumb" linkToFull={!e.href} />
              )}
              <span class="event-tag">{e.tag}</span>
              <span class="event-date">{e.date}</span>
              <h3 set:html={wrapHeadingHtml(e.title)} />
              <p>{e.body}</p>
              <div class="event-meta">{e.meta}</div>
              {e.href && <span class="event-register">線上報名 →</span>}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>已結束的活動</h2>
      <div class="event-grid">
        {past.map((e) => {
          const Tag = e.href ? "a" : "article";
          return (
            <Tag class="event-card is-past" href={e.href} style={`--dot: ${e.color}; --dot-text: ${e.colorText}`}>
              {e.poster && (
                <CoursePoster src={e.poster} alt={`${e.title} 課程海報`} variant="thumb" linkToFull={!e.href} />
              )}
              <span class="event-tag">{e.tag}</span>
              <span class="event-date">{e.date}</span>
              <h3 set:html={wrapHeadingHtml(e.title)} />
              <p>{e.body}</p>
              <div class="event-meta">{e.meta}</div>
              {e.href && <span class="event-register">課程頁 →</span>}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-links {
    display: flex;
    gap: 16px;
  }

  .hero-links a {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--blue-deep);
    text-decoration: none;
  }

  .hero-links a:hover {
    text-decoration: underline;
  }

  .section {
    padding: 44px 0;
  }

  .section-alt {
    background: var(--card);
    border-top: 1px solid var(--line);
  }

  .section h2 {
    font-size: clamp(1.1rem, 3vw, 1.3rem);
    margin-bottom: 20px;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 860px) {
    .event-grid {
      grid-template-columns: 1fr;
    }
  }

  .event-card {
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-left: 4px solid var(--dot);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  a.event-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .event-register {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--dot-text);
  }

  .section-alt .event-card {
    background: var(--bg-alt);
  }

  .event-card.is-past {
    opacity: 0.82;
  }

  .event-tag {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--dot-text);
    background: color-mix(in srgb, var(--dot) 14%, var(--card));
    padding: 3px 10px;
    border-radius: 999px;
  }

  .event-date {
    font-size: 0.76rem;
    color: var(--ink-faint);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .event-card h3 {
    font-size: 0.98rem;
    line-height: 1.55;
    font-weight: 700;
  }

  .event-card p {
    font-size: 0.84rem;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.65;
  }

  .event-meta {
    font-size: 0.76rem;
    color: var(--ink-faint);
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
  }
</style>
