---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { wrapHeadingHtml } from "../../lib/wrap-heading";

interface EventItem {
  date: string;
  sortKey: string;
  tag: string;
  color: string;
  colorText: string;
  title: string;
  body: string;
  meta: string;
  href?: string;
}

