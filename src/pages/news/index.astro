  {
    date: "8月15日（六）",
    sortKey: "2026-08-15",
    tag: "實體工作坊",
    color: "var(--magenta)",
    colorText: "var(--magenta-deep)",
    title: "寄養家庭中的性議題：理解、陪伴與合作實務",
    body: "從第一線實務經驗出發，分享心理師如何理解寄養家庭中的兒少性發展脈絡，以及如何與寄養家長、社工建立合作模式。",
    meta: "講師 王嘉琪",
  },
  {
    date: "8月7日（五）",
    sortKey: "2026-08-07",
    tag: "走讀活動",
    color: "var(--orange)",
    colorText: "var(--orange-deep)",
    title: "夜遊三流艋舺：流氓、流鶯、流浪漢",
