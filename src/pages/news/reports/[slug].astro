---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import CoursePoster from "../../../components/CoursePoster.astro";
import { allCourseReports } from "../../../data/course-reports";

export function getStaticPaths() {
  return allCourseReports.map((r) => ({
    params: { slug: r.slug },
    props: r,
  }));
}

const { title, date, speaker, writer, tags, color, colorText, lead, poster, images = [], sections } = Astro.props;

// 第一張圖放文章開頭當主視覺，其餘（少數報導有兩張）擺在文末
const [cover, ...moreImages] = poster ? [poster, ...images] : images;
---

<ArticleLayout
  title={title}
  eyebrow="課程報導"
  eyebrowHref="/news/reports"
  date={date}
  meta={speaker ? [`講師 ${speaker}`] : []}
  accent={color}
  accentText={colorText}
>
  {cover && <CoursePoster src={cover} alt={`${title} 課程海報`} />}

  <p class="lead-para">{lead}</p>
  {writer && <p class="byline">撰文・{writer}</p>}

  {sections.map((s: { heading?: string; paragraphs: string[] }) => (
    <>
      {s.heading && <h2>{s.heading}</h2>}
      {s.paragraphs.map((p: string) => <p>{p}</p>)}
    </>
  ))}

  {moreImages.map((src: string) => (
    <CoursePoster src={src} alt={`${title} 活動照片`} />
  ))}

  {tags && (
    <div class="tag-row">
      {tags.map((t: string) => <span>#{t}</span>)}
    </div>
  )}
</ArticleLayout>

<style>
  .lead-para {
    font-size: 1.08rem !important;
    color: var(--ink) !important;
    font-weight: 600;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px dashed var(--line);
  }

  .tag-row span {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
</style>
