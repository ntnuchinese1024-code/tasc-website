---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import CoursePoster from "../../../components/CoursePoster.astro";
import ReportKeyPoints from "../../../components/ReportKeyPoints.astro";
import ReportVoices from "../../../components/ReportVoices.astro";
import EventFeedbackForm from "../../../components/EventFeedbackForm.astro";
import { getAllReports, getReport } from "../../../lib/reports";

export async function getStaticPaths() {
  const reports = await getAllReports();

  // 列表用的資料沒有全文，逐篇補抓完整內容
  const pages = [];
  for (const summary of reports) {
    const full = await getReport(summary.slug, summary.source);
    if (full) pages.push({ params: { slug: full.slug }, props: full });
  }
  return pages;
}

const {
  slug, source, title, date, speaker, writer, tags, color, colorText, lead,
  poster, posterWide, guide, images = [], sections = [], keyPoints, voices, voiceStats, bodyHtml,
} = Astro.props;

// 第一張圖放文章開頭當主視覺，其餘（少數報導有兩張）擺在文末
const [cover, ...moreImages] = poster ? [poster, ...images] : images;
---

<ArticleLayout
  title={title}
  eyebrow="課程報導"
  eyebrowHref="/news/reports"
  date={date}
  meta={[
    ...(speaker ? [`講師 ${speaker}`] : []),
    ...(guide ? [`導覽 ${guide}`] : []),
  ]}
  accent={color}
  accentText={colorText}
>
  {cover && (
    <div class:list={["report-cover", { wide: posterWide }]}>
      <CoursePoster src={cover} alt={`${title} ${posterWide ? "活動主視覺" : "課程海報"}`} variant={posterWide ? "natural" : "full"} linkToFull />
    </div>
  )}

  <p class="lead-para">{lead}</p>
  {writer && <p class="byline">撰文・{writer}</p>}

  {keyPoints && keyPoints.length > 0 && <ReportKeyPoints points={keyPoints} />}

  {/* 報名系統寫的報導帶 HTML（Markdown 轉出來的）；搬遷前的本地報導仍是 sections */}
  {bodyHtml ? (
    <div class="report-body" set:html={bodyHtml} />
  ) : (
    sections.map((s: { heading?: string; paragraphs: string[]; quote?: string }) => (
      <>
        {s.heading && <h2 class="section-heading">{s.heading}</h2>}
        {s.paragraphs.map((p: string) => <p>{p}</p>)}
        {s.quote && <blockquote class="pull-quote"><p>{s.quote}</p></blockquote>}
      </>
    ))
  )}

  {voices && voices.length > 0 && <ReportVoices voices={voices} stats={voiceStats} />}

  {moreImages.map((src: string) => (
    <CoursePoster src={src} alt={`${title} 活動照片`} />
  ))}

  {tags && (
    <div class="tag-row">
      {tags.map((t: string) => <span>#{t}</span>)}
    </div>
  )}

  {/* 回饋問卷：只有報名系統的活動才有；秘書處在後台開放時才會出現，關閉後整塊消失 */}
  {source === "registration" && (
    <div class="report-feedback">
      <EventFeedbackForm slug={slug} mode="embed" />
    </div>
  )}
</ArticleLayout>

<style>
  /* ArticleLayout 已經用 .article-body :global(h2/p) 管到內文，
     這裡只補它沒涵蓋到的條列與引言——舊報導是純段落，不會用到這些。 */
  .report-body :global(ul),
  .report-body :global(ol) {
    margin: 0 0 1.3rem;
    padding-left: 1.4rem;
  }

  .report-body :global(li) {
    margin-bottom: 0.55rem;
    line-height: 1.95;
    color: var(--ink-soft);
  }

  .report-body :global(blockquote) {
    margin: 1.6rem 0;
    padding: 0.15rem 0 0.15rem 1.1rem;
    border-left: 3px solid var(--accent);
    color: var(--ink-faint);
  }

  .report-body :global(a) {
    color: var(--accent-text);
  }

  /* 橫式封面：撐滿欄寬、圓角加陰影，像一張活動明信片 */
  .report-cover.wide {
    margin: 0 0 32px;
  }

  .report-cover.wide :global(.poster-frame) {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .report-cover.wide :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 小標前面一小段主色條，讓長文有段落節奏 */
  .section-heading::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--accent);
    vertical-align: 0.32em;
    margin-right: 10px;
  }

  /* 金句：大字、置中、上下各一個引號，不用左邊直線（那是一般引言的樣式） */
  .pull-quote {
    position: relative;
    margin: 32px 0 36px;
    padding: 30px 24px 26px;
    text-align: center;
    background: color-mix(in srgb, var(--accent) 7%, var(--card));
    border-radius: 16px;
  }

  .pull-quote::before {
    content: "“";
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--accent);
  }

  .pull-quote p {
    margin: 0 !important;
    font-family: var(--font-display);
    font-size: 1.28rem !important;
    font-weight: 700;
    line-height: 1.7 !important;
    color: var(--accent-text) !important;
    letter-spacing: 0.03em;
  }

  @media (max-width: 560px) {
    .pull-quote {
      padding: 28px 18px 22px;
    }

    .pull-quote p {
      font-size: 1.1rem !important;
    }
  }

  .lead-para {
    font-size: 1.08rem !important;
    color: var(--ink) !important;
    font-weight: 600;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px dashed var(--line);
  }

  .report-feedback {
    margin-top: 40px;
  }

  .tag-row span {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
</style>
